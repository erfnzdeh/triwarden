    "This replaces the passkey already saved on that login.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sustituye la clave de acceso ya guardada en ese inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplace la clé d'accès déjà enregistrée sur cet identifiant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのログインに保存済みのパスキーが置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 로그인에 이미 저장된 패스키를 바꿉니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะแทนที่พาสคีย์ที่บันทึกไว้แล้วในข้อมูลเข้าสู่ระบบนั้น"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "咁樣會取代嗰個登入項目入面已經儲存嘅通行密鑰。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会替换该登录项上已保存的通行密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會取代該登入項目上已儲存的通行密鑰。"
          }
        }
      }
    },
    "This site needs a key type Triwarden can't create.": {
      "localizations": {
        "es": {
