    "This passkey can't be used here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave de acceso no se puede usar aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé d'accès ne peut pas être utilisée ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパスキーはここでは使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
