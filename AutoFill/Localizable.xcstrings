    "Saved encrypted in your vault, and synced to your other devices.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado cifrado en tu caja fuerte y sincronizado con tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré chiffré dans votre coffre, et synchronisé avec vos autres appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫に暗号化して保存し、ほかのデバイスと同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에 암호화하여 저장되고, 다른 기기와 동기화됩니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกแบบเข้ารหัสในห้องนิรภัย และซิงค์ไปยังอุปกรณ์อื่นของคุณ."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "加密儲存喺你嘅保險庫，同步到你其他裝置。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密保存在你的保险库，并同步到你的其他设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加密儲存在你的保險庫，並同步到你的其他裝置。"
          }
        }
      }
    },
    "Saved to your vault, on every device.": {
