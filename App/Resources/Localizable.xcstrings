          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden solicitó un captcha. Inicia sesión una vez en vault.bitwarden.com desde esta red y vuelve a intentarlo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden ขอ captcha เข้าสู่ระบบที่ vault.bitwarden.com หนึ่งครั้งจากเครือข่ายนี้ แล้วลองอีกครั้ง"
          }
        }
      }
    },
