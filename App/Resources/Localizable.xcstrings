          }
        }
      }
    },
    "The values listed here are forgotten. Items you saved are not affected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに表示されている値は消去されます。保存済みの項目には影響しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里列出的值会被清除，已保存的项目不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡列出的值會被清除，已儲存的項目不受影響。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢度列出嘅值會清走，已經儲存嘅項目唔受影響。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 나열된 값은 잊힙니다. 저장한 항목에는 영향이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs listées ici sont oubliées. Les éléments que vous avez enregistrés ne sont pas affectés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores listados aquí se olvidan. Los elementos que guardaste no se ven afectados."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าที่แสดงที่นี่จะถูกลืม รายการที่คุณบันทึกไว้จะไม่ได้รับผลกระทบ"
          }
        }
      }
    },
    "Their vault, read-only. Nothing is saved on this Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の保管庫（読み取り専用）。この Mac には保存されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方的保险库，只读。不会保存在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方的保險庫，唯讀。不會儲存在這台 Mac 上。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "對方嘅保險庫，唯讀。唔會儲存喺呢部 Mac。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대의 보관함이며 읽기 전용입니다. 이 Mac에는 아무것도 저장되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son coffre, en lecture seule. Rien n'est enregistré sur ce Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su caja fuerte, solo lectura. No se guarda nada en este Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องนิรภัยของอีกฝ่าย แบบอ่านอย่างเดียว ไม่มีสิ่งใดถูกบันทึกบน Mac เครื่องนี้"
          }
        }
      }
    },
    "There's nothing to import in this file.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルには読み込めるものがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件中没有可导入的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案中沒有可匯入的內容。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個檔案冇嘢可以匯入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일에는 가져올 내용이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne contient rien à importer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que importar en este archivo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีสิ่งที่จะนำเข้าในไฟล์นี้"
          }
        }
      }
    },
    "These passwords appear in known breaches. Change them on each site.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのパスワードは既知の漏えいに含まれています。各サイトで変更してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些密码出现在已知的泄露数据中，请到各网站更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些密碼出現在已知的外洩資料中，請到各網站更改。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢啲密碼出現喺已知嘅外洩資料入面，請去每個網站改返。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 비밀번호는 알려진 유출에 포함되어 있습니다. 각 사이트에서 변경하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces mots de passe figurent dans des fuites connues. Changez-les sur chaque site."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas contraseñas aparecen en filtraciones conocidas. Cámbialas en cada sitio."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านเหล่านี้ปรากฏในการรั่วไหลที่ทราบแล้ว เปลี่ยนรหัสบนแต่ละไซต์"
          }
        }
      }
    },
    "These sites are saved with http://, so the password travels unencrypted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのサイトは http:// で保存されており、パスワードが暗号化されずに送信されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些网站以 http:// 保存，密码会以未加密方式传输。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些網站以 http:// 儲存，密碼會以未加密方式傳送。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢啲網站用 http:// 儲存，密碼傳送時冇加密。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사이트는 http://로 저장되어 있어 비밀번호가 암호화되지 않은 채 전송됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces sites sont enregistrés avec http://, donc le mot de passe circule sans chiffrement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos sitios están guardados con http://, así que la contraseña viaja sin cifrar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไซต์เหล่านี้ถูกบันทึกด้วย http:// ดังนั้นรหัสผ่านจึงถูกส่งโดยไม่เข้ารหัส"
          }
        }
      }
    },
    "These sites offer one-time codes. Turn two-step login on there, then save the code here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのサイトはワンタイムコードに対応しています。サイトで 2 段階ログインを有効にし、ここにコードを保存してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些网站提供一次性验证码。请在网站开启两步登录，再把验证码保存到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些網站提供一次性驗證碼。請在網站開啟兩步驟登入，再把驗證碼存到這裡。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢啲網站提供一次性驗證碼。喺網站開咗兩步驟登入，再將驗證碼存喺度。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사이트는 일회용 코드를 제공합니다. 그곳에서 2단계 로그인을 켠 다음 여기에 코드를 저장하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces sites proposent des codes à usage unique. Activez-y la connexion en deux étapes, puis enregistrez le code ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos sitios ofrecen códigos de un solo uso. Activa allí el inicio de sesión en dos pasos y guarda el código aquí."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไซต์เหล่านี้มีรหัสใช้ครั้งเดียว เปิดการเข้าสู่ระบบสองขั้นตอนที่นั่น แล้วบันทึกรหัสที่นี่"
          }
        }
      }
    },
    "They can ask for access; if you don't reject the request within the wait time, they can view your vault or set a new master password for it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを申請できます。待機期間内に拒否しなければ、保管庫を閲覧したり新しいマスターパスワードを設定したりできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他们可以申请访问；如果你在等待期内没有拒绝，他们就能查看你的保险库，或为它设置新的主密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他們可以申請存取；若你在等待期間內未拒絕，他們就能查看你的保險庫，或為它設定新的主密碼。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "佢哋可以申請存取；如果你喺等待期內冇拒絕，佢哋就可以睇你嘅保險庫，或者幫佢設定新嘅主密碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근을 요청할 수 있습니다. 대기 시간 안에 요청을 거부하지 않으면 보관함을 보거나 새 마스터 비밀번호를 설정할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils peuvent demander l'accès ; si vous ne refusez pas la demande dans le délai d'attente, ils peuvent consulter votre coffre ou définir un nouveau mot de passe principal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pueden solicitar acceso; si no rechazas la solicitud dentro del tiempo de espera, pueden ver tu caja fuerte o establecer una nueva contraseña maestra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พวกเขาสามารถขอสิทธิ์เข้าถึงได้ หากคุณไม่ปฏิเสธคำขอภายในเวลารอ พวกเขาสามารถดูห้องนิรภัยหรือตั้งรหัสผ่านหลักใหม่ได้"
          }
        }
      }
    },
    "They can no longer ask for access to your vault. You can invite them again later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人はあなたの保管庫へのアクセスを申請できなくなります。あとで再度招待できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方将无法再申请访问你的密码库。之后可以再次邀请。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方將無法再申請存取你的密碼庫。之後可以再次邀請。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "對方唔可以再申請存取你嘅保險庫。你之後可以再邀請佢哋。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 보관함 접근을 요청할 수 없습니다. 나중에 다시 초대할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils ne peuvent plus demander l'accès à votre coffre. Vous pourrez les inviter à nouveau plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no pueden solicitar acceso a tu caja fuerte. Puedes invitarlos de nuevo más tarde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พวกเขาไม่สามารถขอสิทธิ์เข้าถึงห้องนิรภัยของคุณได้อีกต่อไป คุณสามารถเชิญพวกเขาอีกครั้งได้ภายหลัง"
          }
        }
      }
    },
    "They can see your items, read-only.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を読み取り専用で閲覧できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他们可以只读查看你的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他們可以唯讀查看你的項目。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "佢哋可以唯讀睇你嘅項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 읽기 전용으로 볼 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils peuvent voir vos éléments, en lecture seule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pueden ver tus elementos, solo lectura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พวกเขาสามารถดูรายการของคุณแบบอ่านอย่างเดียว"
          }
        }
      }
    },
    "They can set a new master password and use your account.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいマスターパスワードを設定してアカウントを使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他们可以设置新的主密码并使用你的账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他們可以設定新的主密碼並使用你的帳號。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "佢哋可以設定新主密碼，仲可以用你嘅帳戶。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 마스터 비밀번호를 설정하고 계정을 사용할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils peuvent définir un nouveau mot de passe principal et utiliser votre compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pueden establecer una nueva contraseña maestra y usar tu cuenta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พวกเขาสามารถตั้งรหัสผ่านหลักใหม่และใช้บัญชีของคุณได้"
          }
        }
      }
    },
    "This account is offline.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントはオフラインです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户当前离线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號目前離線。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個帳戶而家離線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 오프라인입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte est hors ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta está sin conexión."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีนี้ออฟไลน์"
          }
        }
      }
    },
    "This account uses Argon2id, which isn't supported yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは Argon2id を使用していますが、まだサポートされていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户使用 Argon2id，目前尚不支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號使用 Argon2id，目前尚未支援。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個帳戶用緊 Argon2id，暫時未支援。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 아직 지원되지 않는 Argon2id를 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte utilise Argon2id, qui n'est pas encore pris en charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta usa Argon2id, que aún no es compatible."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีนี้ใช้ Argon2id ซึ่งยังไม่รองรับ"
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此動作無法復原。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個做唔返轉頭。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action ne peut pas être annulée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกระทำนี้ไม่สามารถเลิกทำได้"
          }
        }
      }
    },
    "This file is encrypted with another account's key. Import it into that account, or export it again as password-protected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは別のアカウントの鍵で暗号化されています。そのアカウントに読み込むか、パスワード保護で書き出し直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件使用另一个账户的密钥加密。请导入到该账户，或重新以密码保护格式导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案是用另一個帳號的密鑰加密的。請匯入到該帳號，或重新以密碼保護格式匯出。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個檔案係用另一個帳戶嘅密鑰加密。請匯入去嗰個帳戶，或者用密碼保護格式重新匯出。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 다른 계정의 키로 암호화되어 있습니다. 해당 계정으로 가져오거나, 비밀번호로 보호하여 다시 내보내세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est chiffré avec la clé d'un autre compte. Importez-le dans ce compte, ou exportez-le à nouveau protégé par mot de passe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo está cifrado con la clave de otra cuenta. Impórtalo en esa cuenta, o expórtalo de nuevo protegido con contraseña."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ถูกเข้ารหัสด้วยคีย์ของบัญชีอื่น นำเข้าไปยังบัญชีนั้น หรือส่งออกอีกครั้งแบบป้องกันด้วยรหัสผ่าน"
          }
        }
      }
    },
    "This file isn't in a format Triwarden can import.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイル形式は Triwarden で読み込めません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden 无法导入这种格式的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden 無法匯入這種格式的檔案。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden 匯入唔到呢種格式嘅檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 Triwarden에서 가져올 수 있는 형식이 아닙니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n'est pas dans un format que Triwarden peut importer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no está en un formato que Triwarden pueda importar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ไม่อยู่ในรูปแบบที่ Triwarden นำเข้าได้"
          }
        }
      }
    },
    "This Mac": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢部 Mac"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้"
          }
        }
      }
    },
    "This Mac has no Touch ID available.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac では Touch ID を利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 没有可用的触控 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 沒有可用的 Touch ID。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢部 Mac 冇可用嘅 Touch ID。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서는 Touch ID를 사용할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID n'est pas disponible sur ce Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no tiene Touch ID disponible."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac เครื่องนี้ไม่มี Touch ID ที่ใช้ได้"
          }
        }
      }
    },
    "This Mac isn't known to the server for this account yet. Log in with your master password once.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac はまだこのアカウントでサーバーに登録されていません。一度マスターパスワードでログインしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器尚未识别这台 Mac。请先用主密码登录一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器尚未認得這台 Mac。請先用主密碼登入一次。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器仲未認得呢部 Mac。請先用主密碼登入一次。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 아직 이 계정으로 서버에 등록되어 있지 않습니다. 마스터 비밀번호로 한 번 로그인하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n'est pas encore connu du serveur pour ce compte. Connectez-vous une fois avec votre mot de passe principal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac aún no es conocido por el servidor para esta cuenta. Inicia sesión una vez con tu contraseña maestra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ยังไม่รู้จัก Mac เครื่องนี้สำหรับบัญชีนี้ เข้าสู่ระบบด้วยรหัสผ่านหลักหนึ่งครั้ง"
          }
        }
      }
    },
    "This passkey can't be used here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパスキーはここでは使用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此使用此通行密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在此使用這個通行密鑰。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個通行密鑰喺呢度用唔到。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 패스키는 여기서 사용할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé d'accès ne peut pas être utilisée ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave de acceso no se puede usar aquí."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้พาสคีย์นี้ที่นี่ไม่ได้"
          }
        }
      }
    },
    "This removes the account and its saved vault from this Mac. Your data stays on the server.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac からアカウントと保存された保管庫を削除します。サーバー上のデータはそのまま残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从这台 Mac 移除此账户及其保存的密码库，服务器上的数据不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從這部 Mac 移除此帳號及其儲存的保險庫，伺服器上的資料不受影響。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個操作會喺呢部 Mac 移走呢個帳戶同埋儲存咗嘅保險庫。你嘅資料會保留喺伺服器。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 계정과 저장된 보관함을 제거합니다. 데이터는 서버에 남습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela retire le compte et son coffre enregistré de ce Mac. Vos données restent sur le serveur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto quita la cuenta y su caja fuerte guardada de este Mac. Tus datos permanecen en el servidor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะนำบัญชีและห้องนิรภัยที่บันทึกไว้ออกจาก Mac เครื่องนี้ ข้อมูลของคุณยังคงอยู่บนเซิร์ฟเวอร์"
          }
        }
      }
    },
    "This replaces the passkey already saved on that login.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのログインに保存済みのパスキーが置き換えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会替换该登录项上已保存的通行密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會取代該登入項目上已儲存的通行密鑰。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "咁樣會取代嗰個登入項目入面已經儲存嘅通行密鑰。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 로그인에 이미 저장된 패스키를 바꿉니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplace la clé d'accès déjà enregistrée sur cet identifiant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sustituye la clave de acceso ya guardada en ese inicio de sesión."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะแทนที่พาสคีย์ที่บันทึกไว้แล้วในข้อมูลเข้าสู่ระบบนั้น"
          }
        }
      }
    },
    "This server doesn't support archiving yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバはまだアーカイブに対応していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器尚不支持归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台伺服器尚不支援封存。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢部伺服器暫時未支援封存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 아직 아카이브를 지원하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur ne prend pas encore en charge l'archivage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor aún no admite el archivado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์นี้ยังไม่รองรับการเก็บถาวร"
          }
        }
      }
    },
    "This shared vault has no shared folders you can add to.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この共有保管庫には追加できる共有フォルダがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个共享保险库没有你可以添加到的共享文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個共享保險庫沒有你可以加入的共享資料夾。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個共享保險庫冇你可以加入嘅共享資料夾。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 공유 보관함에는 추가할 수 있는 컬렉션이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce coffre partagé n'a aucune collection à laquelle vous pouvez ajouter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta caja fuerte compartida no tiene colecciones a las que puedas añadir."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องนิรภัยที่ใช้ร่วมกันนี้ไม่มีคอลเลกชันที่คุณเพิ่มได้"
          }
        }
      }
    },
    "This site needs a key type Triwarden can't create.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイトには Triwarden で作成できない鍵の種類が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
