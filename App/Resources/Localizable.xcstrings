    "Removes the account and its saved vault from this Mac. Your data stays on the server.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac からアカウントと保存された保管庫を削除します。データはサーバーに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
