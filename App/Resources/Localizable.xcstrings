            "state": "translated",
            "value": "Connectez-vous à nouveau pour synchroniser ce compte. Le coffre enregistré reste disponible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a iniciar sesión para sincronizar esta cuenta. La caja fuerte guardada sigue disponible."
