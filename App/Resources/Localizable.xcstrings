    "Trust an app from the prompt when it asks to sign. Trust lasts until the vault locks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust an app from the prompt when it asks to sign. Trust lasts until the vault locks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名を求められたときにそのアプリを信頼できます。信頼は保管庫をロックするまで続きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "app 来要求签名时，可以从提示里信任它。信任持续到保险库上锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "app 來要求簽名時，可以從提示裡信任它。信任持續到保險庫上鎖。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "app 嚟要求簽名時，可以喺提示入面信任佢。信任會維持到保險庫上鎖。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명을 요청하는 메시지에서 앱을 신뢰할 수 있습니다. 신뢰는 보관함이 잠길 때까지 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites confiance à une app depuis l'invite lorsqu'elle demande à signer. La confiance dure jusqu'au verrouillage du coffre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confía en una app desde el aviso cuando pida firmar. La confianza dura hasta que la caja fuerte se bloquee."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อถือแอปจากข้อความแจ้งเมื่อแอปขอลงนาม ความเชื่อถือจะคงอยู่จนกว่าห้องนิรภัยจะล็อก"
          }
        }
      }
    },
