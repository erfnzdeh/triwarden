        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 계정에 새 마스터 비밀번호를 설정한 다음, 그 비밀번호로 로그인하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un nouveau mot de passe principal pour son compte, puis connectez-vous avec ce mot de passe."
