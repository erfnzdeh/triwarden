    "The account and its saved vault are removed from this Mac. Your vault stays on the server.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントと保存された保管庫はこの Mac から削除されます。サーバ上の保管庫はそのままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户及其保存的密码库会从这台 Mac 移除，服务器上的密码库不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號及其儲存的保險庫會從這部 Mac 移除，伺服器上的保險庫不受影響。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶同佢儲存嘅保險庫會從呢部 Mac 移除，伺服器上嘅保險庫唔受影響。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 저장된 보관함이 이 Mac에서 제거됩니다. 보관함은 서버에 그대로 남습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte et son coffre enregistré sont retirés de ce Mac. Votre coffre reste sur le serveur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta y su caja fuerte guardada se quitan de este Mac. Tu caja fuerte permanece en el servidor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีและห้องนิรภัยที่บันทึกไว้จะถูกนำออกจาก Mac เครื่องนี้ ห้องนิรภัยของคุณยังคงอยู่บนเซิร์ฟเวอร์"
          }
        }
      }
    },
    "The file is removed from your vault on every device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスの保管庫からファイルが削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件会从你所有设备上的密码库中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會從你所有裝置上的保險庫中移除。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案會從你所有裝置嘅保險庫入面移除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 모든 기기의 보관함에서 제거됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est retiré de votre coffre sur chaque appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se elimina de tu caja fuerte en cada dispositivo."
          }
        },
        "th": {
