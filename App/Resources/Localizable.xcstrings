    "“%@” asks for your master password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」にはマスターパスワードが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”需要你的主密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」需要你的主密碼。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」要你嘅主密碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”에서 마스터 비밀번호를 요청합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » demande votre mot de passe principal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» solicita tu contraseña maestra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ขอรหัสผ่านหลักของคุณ"
          }
        }
      }
    },
    "“%@” has an old-style attachment; move it from the web vault.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」には古い形式の添付ファイルがあります。Web 保管庫から移動してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”有旧式附件，请从网页版保险库移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」有舊式附件，請從網頁版保險庫移動。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」有舊式附件，請喺網頁版保險庫移動佢。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”에 이전 형식의 첨부 파일이 있습니다. 웹 보관함에서 옮기세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a une pièce jointe à l'ancien format ; déplacez-le depuis le coffre web."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» tiene un archivo adjunto de formato antiguo; muévelo desde la caja fuerte web."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” มีไฟล์แนบรูปแบบเก่า ให้ย้ายจากห้องนิรภัยเว็บ"
          }
        }
      }
    },
    "“%@” has attachments; move it from the web vault.": {
      "extractionState": "stale",
