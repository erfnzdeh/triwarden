    "A random address at a domain that accepts any mailbox.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のメールボックスを受け付けるドメインでランダムなアドレスを作ります。"
          }
        },
        "zh-Hans": {
