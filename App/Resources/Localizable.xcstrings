    "Adds a random tag, e.g. you+k3x9q2ma@example.com, so you can tell who shared your address.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "you+k3x9q2ma@example.com のようなランダムなタグを付け、誰がアドレスを共有したか分かるようにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加随机标签，例如 you+k3x9q2ma@example.com，让你知道是谁泄露了你的地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入隨機標籤，例如 you+k3x9q2ma@example.com，讓你知道是誰洩露了你的地址。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "加入隨機標籤，例如 you+k3x9q2ma@example.com，等你知道係邊個洩露咗你個地址。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "you+k3x9q2ma@example.com과 같은 임의의 태그를 추가하여, 누가 주소를 공유했는지 알 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une étiquette aléatoire, p. ex. you+k3x9q2ma@example.com, pour savoir qui a partagé votre adresse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una etiqueta aleatoria, p. ej., you+k3x9q2ma@example.com, para saber quién compartió tu dirección."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มแท็กแบบสุ่ม เช่น you+k3x9q2ma@example.com เพื่อให้ทราบว่าใครแชร์ที่อยู่ของคุณ"
          }
        }
      }
    },
