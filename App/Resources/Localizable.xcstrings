    "Remove an unused tool from Secrets before you add another.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のツールを追加する前に、「シークレット」から使っていないツールを削除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加其他工具前，请先从“机密”移除不用的工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增其他工具前，請先從「機密資料」移除不用的工具。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "新增其他工具之前，請先喺「機密資料」移除冇用嘅工具。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 도구를 추가하기 전에 '보안 정보'에서 사용하지 않는 도구를 제거하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez un outil inutilisé dans Secrets avant d'en ajouter un autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita una herramienta que no uses en Secretos antes de añadir otra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเครื่องมือที่ไม่ได้ใช้ออกจากข้อมูลลับก่อนเพิ่มเครื่องมืออื่น"
          }
        }
      }
    },
    "Remove an unused tool setup before adding another. Your vault keys are kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のツールを追加する前に、使っていないツールの設定を削除してください。保管庫のキーは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加其他工具前，请先移除不用的工具设置。保险库中的密钥会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增其他工具前，請先移除不用的工具設定。保險庫中的金鑰會保留。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "新增其他工具之前，請先移除冇用嘅工具設定。保險庫入面嘅密鑰會保留。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 도구를 추가하기 전에 사용하지 않는 도구 설정을 제거하세요. 보관함의 키는 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez une configuration d'outil inutilisée avant d'en ajouter une autre. Les clés de votre coffre sont conservées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita una configuración de herramienta que no uses antes de añadir otra. Las claves de tu caja fuerte se conservan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำการตั้งค่าเครื่องมือที่ไม่ได้ใช้ออกก่อนเพิ่มรายการอื่น คีย์ในห้องนิรภัยจะยังคงอยู่"
          }
        }
      }
