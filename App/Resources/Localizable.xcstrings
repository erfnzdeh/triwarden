    "Paused tools never ask for approval or receive keys.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中のツールは承認を求めず、キーも受け取りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停的工具不会要求批准，也不会收到密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停的工具不會要求核准，也不會收到金鑰。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停嘅工具唔會要求批准，亦唔會收到密鑰。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 정지된 도구는 승인을 요청하거나 키를 받지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils suspendus ne demandent jamais d'autorisation et ne reçoivent aucune clé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas en pausa nunca piden aprobación ni reciben claves."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องมือที่หยุดชั่วคราวจะไม่ขออนุมัติหรือได้รับคีย์"
          }
        }
      }
    },
