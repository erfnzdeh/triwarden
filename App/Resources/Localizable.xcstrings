    "This signs one SSH operation. The private key stays in your vault.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs one SSH operation. The private key stays in your vault."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH の署名を 1 回行います。秘密鍵は保管庫に残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次只做一次 SSH 签名。私钥留在保险库里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次只做一次 SSH 簽名。私鑰留在保險庫裡。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢次只做一次 SSH 簽名。私鑰會留喺保險庫入面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 작업 하나에 서명합니다. 개인 키는 보관함에 남습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci signe une opération SSH. La clé privée reste dans votre coffre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto firma una operación SSH. La clave privada permanece en tu caja fuerte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือการลงนามการทำงาน SSH หนึ่งครั้ง คีย์ส่วนตัวยังอยู่ในห้องนิรภัยของคุณ"
          }
        }
      }
    },
    "This app has asked to sign before.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app has asked to sign before."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは以前にも署名を求めています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 app 先前来要过签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 app 先前來要過簽名。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個 app 之前嚟要過簽名。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 이전에 서명을 요청한 적이 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app a déjà demandé à signer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app ya ha pedido firmar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปนี้เคยขอลงนามมาก่อน"
          }
        }
      }
    },
    "macOS will ask for Touch ID or your Mac login password. That password stays with macOS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS will ask for Touch ID or your Mac login password. That password stays with macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続いて macOS が Touch ID またはこの Mac のログインパスワードを求めます。そのパスワードは macOS だけが扱います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 接着会要求 Touch ID 或这台 Mac 的登录密码。这组密码只留在 macOS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 接著會要求 Touch ID 或這台 Mac 的登入密碼。這組密碼只留在 macOS。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 跟著會要求 Touch ID 或者呢部 Mac 嘅登入密碼。呢組密碼只會留喺 macOS。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 Touch ID 또는 Mac 로그인 비밀번호를 묻습니다. 그 비밀번호는 macOS에 남습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demandera Touch ID ou le mot de passe de connexion de votre Mac. Ce mot de passe reste dans macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pedirá Touch ID o la contraseña de inicio de sesión de tu Mac. Esa contraseña permanece en macOS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
