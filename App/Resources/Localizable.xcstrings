    "Send text or a file through an end-to-end encrypted link that expires on its own.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドツーエンドで暗号化され、自動で期限切れになるリンクでテキストやファイルを送れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过端到端加密、会自动失效的链接发送文字或文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過端對端加密、會自動失效的連結傳送文字或檔案。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用端對端加密、會自動失效嘅連結傳送文字或檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스스로 만료되는 종단간 암호화 링크로 텍스트나 파일을 보냅니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez un texte ou un fichier via un lien chiffré de bout en bout qui expire de lui-même."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un texto o un archivo mediante un enlace cifrado de extremo a extremo que caduca solo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งข้อความหรือไฟล์ผ่านลิงก์ที่เข้ารหัสแบบต้นทางถึงปลายทางและหมดอายุเอง."
          }
        }
      }
    },
