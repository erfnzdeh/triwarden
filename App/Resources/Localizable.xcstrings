    "A device wants to sign in to %@ without the master password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスがマスターパスワードなしで %@ にサインインしようとしています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有设备想在不输入主密码的情况下登录 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有裝置想在不輸入主密碼的情況下登入 %@。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "有部裝置想唔用主密碼登入 %@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 마스터 비밀번호 없이 %@에 로그인하려고 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appareil veut se connecter à %@ sans le mot de passe principal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo quiere iniciar sesión en %@ sin la contraseña maestra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
