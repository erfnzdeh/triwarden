            "state": "translated",
            "value": "Asistente de terminal"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวช่วยเทอร์มินัล"
          }
        }
      }
    },
    "Terminal Helper Setup…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルヘルパーの設定…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端辅助程序设置…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機輔助程式設定…"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機輔助程式設定…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 도우미 설정…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration de l'assistant de terminal…"
          }
        },
        "es": {
          "stringUnit": {
