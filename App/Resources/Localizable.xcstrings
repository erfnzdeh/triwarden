          "stringUnit": {
            "state": "translated",
            "value": "จำนวนรอบ: %lld"
          }
        }
      }
    },
    "Its items aren't deleted; they move out of the folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中の項目は削除されず、フォルダの外に移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中的项目不会被删除，只会移出文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中的項目不會被刪除，只會移出資料夾。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "入面嘅項目唔會畀刪走，只會移出資料夾。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목은 삭제되지 않고 폴더 밖으로 이동합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses éléments ne sont pas supprimés ; ils sortent du dossier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus elementos no se eliminan; salen de la carpeta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการจะไม่ถูกลบ แต่จะย้ายออกจากโฟลเดอร์"
          }
        }
      }
    },
    "Its items leave this Mac. An admin has to invite you again to get them back.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目はこの Mac から消えます。戻すには管理者に再度招待してもらう必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的项目会从这台 Mac 移除。需要管理员再次邀请你才能取回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的項目會從這台 Mac 移除。需要管理員再次邀請你才能取回。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "佢嘅項目會喺呢部 Mac 消失。要管理員再邀請你先攞得返。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목이 이 Mac에서 사라집니다. 다시 받으려면 관리자가 다시 초대해야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses éléments quittent ce Mac. Un administrateur doit vous inviter à nouveau pour les récupérer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus elementos salen de este Mac. Un administrador tiene que invitarle de nuevo para recuperarlos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการจะออกจาก Mac เครื่องนี้ หากต้องการนำกลับ ผู้ดูแลต้องเชิญคุณอีกครั้ง"
          }
        }
      }
    },
    "Its link stops working right away.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクはすぐに無効になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其链接会立即失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的連結會立即失效。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "佢條連結會即刻失效。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크가 즉시 작동을 멈춥니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son lien cesse de fonctionner tout de suite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su enlace deja de funcionar de inmediato."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์จะหยุดทำงานทันที"
          }
        }
      }
    },
    "Its subfolders move with it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブフォルダも一緒に移動します。"
          }
