    },
    "Copied secrets are marked as concealed, so clipboard managers skip them.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーした機密情報は非表示として扱われ、クリップボード管理ツールに記録されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝的机密信息会标记为隐藏，剪贴板管理工具不会记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝的機密資料會標記為隱藏，剪貼板管理工具不會記錄。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "複製嘅機密資料會標記做隱藏，剪貼簿管理工具唔會記錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 비밀은 숨김으로 표시되어 클립보드 관리 도구가 건너뜁니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les secrets copiés sont marqués comme masqués, afin que les gestionnaires de presse-papiers les ignorent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los secretos copiados se marcan como ocultos, de modo que los gestores del portapapeles los omiten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลลับที่คัดลอกจะถูกทำเครื่องหมายว่าซ่อนไว้ ดังนั้นตัวจัดการคลิปบอร์ดจะข้ามไป"
          }
        }
      }
    },
    "Copied the password for %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のパスワードをコピーしました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制 %@ 的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拷貝 %@ 的密碼。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已複製咗 %@ 嘅密碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 비밀번호를 복사했습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot de passe de %@ copié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseña de %@ copiada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกรหัสผ่านของ %@ แล้ว"
          }
        }
      }
    },
    "Copies an item's password. It's cleared from the clipboard after the delay set in Triwarden.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目のパスワードをコピーします。Triwarden で設定した時間が経つとクリップボードから消去されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制项目的密码，并在 Triwarden 设定的时间后从剪贴板清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝項目的密碼，並在 Triwarden 設定的時間後從剪貼板清除。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "複製項目嘅密碼。Triwarden 設定嘅時間一到，就會喺剪貼簿清除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목의 비밀번호를 복사합니다. Triwarden에 설정한 시간이 지나면 클립보드에서 지워집니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie le mot de passe d’un élément. Il est effacé du presse-papiers après le délai défini dans Triwarden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia la contraseña de un elemento. Se borra del portapapeles tras el tiempo definido en Triwarden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกรหัสผ่านของรายการ ระบบจะลบรหัสผ่านออกจากคลิปบอร์ดหลังจากเวลาที่ตั้งไว้ใน Triwarden"
          }
        }
      }
    },
