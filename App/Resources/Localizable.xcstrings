        "ja" : { "stringUnit" : { "state" : "translated", "value" : "今回だけ許可" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只允许这次" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只允許這次" } },
        "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "只允許這次" } }
      }
    },
    "Allow for 10 Minutes" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow for 10 Minutes" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "10 分間許可" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "允许 10 分钟" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "允許 10 分鐘" } },
        "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "允許 10 分鐘" } }
      }
    },
    "Trust Until Lock" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Trust Until Lock" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ロックまで信頼" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "直到上锁前信任" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "直到上鎖前信任" } },
        "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "直到上鎖前信任" } }
      }
    },
    "Trusted until the vault locks" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Trusted until the vault locks" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保管庫をロックするまで信頼" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "直到保险库上锁前信任" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "直到保險庫上鎖前信任" } },
        "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "直到保險庫上鎖前信任" } }
      }
    },
    "Trust an app from the prompt when it asks to sign. Trust lasts until the vault locks." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Trust an app from the prompt when it asks to sign. Trust lasts until the vault locks." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "署名を求められたときにそのアプリを信頼できます。信頼は保管庫をロックするまで続きます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "app 来要求签名时，可以从提示里信任它。信任持续到保险库上锁。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "app 來要求簽名時，可以從提示裡信任它。信任持續到保險庫上鎖。" } },
        "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "app 來要求簽名時，可以從提示裡信任它。信任持續到保險庫上鎖。" } }
      }
    },
    "Notifications" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications" } },
