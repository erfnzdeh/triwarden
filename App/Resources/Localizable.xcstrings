    },
    "The PIN then works only until Triwarden quits, and is never written to disk.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN は Triwarden を終了するまでのみ有効で、ディスクには書き込まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN 码仅在 Triwarden 退出前有效，且永不写入磁盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN 碼只在 Triwarden 結束前有效，且永不寫入磁碟。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN 碼用到 Triwarden 熄咗就得，而且永遠唔會寫落磁碟。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그러면 PIN은 Triwarden이 종료될 때까지만 작동하며, 디스크에는 기록되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le PIN ne fonctionne alors que jusqu'à la fermeture de Triwarden, et n'est jamais écrit sur le disque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PIN solo funciona hasta que Triwarden se cierre, y nunca se escribe en el disco."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จากนั้น PIN จะใช้ได้จนกว่า Triwarden จะปิดเท่านั้น และจะไม่ถูกเขียนลงดิสก์"
          }
        }
      }
    },
    "The same PIN again": {
      "localizations": {
        "ja": {
