    "Bitwarden deletes items for good %lld days after they go to the Trash." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitwarden はゴミ箱に入れてから %lld 日後に項目を完全に削除します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitwarden 会在项目移至废纸篓 %lld 天后将其永久删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitwarden 會在項目移至垃圾桶 %lld 天後將其永久刪除。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitwarden 會喺項目放入垃圾桶 %lld 日之後永久刪除。"
          }
        }
      }
    },
    "Bitwarden deletes items for good %lld days after they go to the Trash. Your own server keeps them until you delete them, unless its admin set it to empty the Trash." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitwarden はゴミ箱に入れてから %lld 日後に項目を完全に削除します。自分のサーバーでは、管理者がゴミ箱の自動削除を設定していない限り、削除するまで残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitwarden 会在项目移至废纸篓 %lld 天后将其永久删除。你自己的服务器会一直保留，直到你删除为止，除非管理员设置了自动清空废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitwarden 會在項目移至垃圾桶 %lld 天後將其永久刪除。你自己的伺服器會一直保留，直到你刪除為止，除非管理員設定了自動清空垃圾桶。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitwarden 會喺項目放入垃圾桶 %lld 日之後永久刪除。你自己嘅伺服器會一直保留，直到你刪除為止，除非管理員設定咗自動清空垃圾桶。"
          }
        }
      }
    },
    "Bitwarden emailed a verification code to %@." : {
