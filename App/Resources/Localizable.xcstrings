        }
      }
    },
    "Sends only the first 5 characters of each password's SHA-1 hash to Have I Been Pwned. Passwords never leave this Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各パスワードの SHA-1 ハッシュの先頭 5 文字だけを Have I Been Pwned に送信します。パスワード自体はこの Mac から出ません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会把每个密码 SHA-1 哈希的前 5 个字符发给 Have I Been Pwned，密码本身不会离开这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會把每個密碼 SHA-1 雜湊的前 5 個字元傳給 Have I Been Pwned，密碼本身不會離開這部 Mac。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只會將每個密碼 SHA-1 雜湊嘅頭 5 個字元傳畀 Have I Been Pwned，密碼本身唔會離開呢部 Mac。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 비밀번호의 SHA-1 해시 앞 5자만 Have I Been Pwned에 보냅니다. 비밀번호는 이 Mac을 벗어나지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie uniquement les 5 premiers caractères du hachage SHA-1 de chaque mot de passe à Have I Been Pwned. Les mots de passe ne quittent jamais ce Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía solo los 5 primeros caracteres del hash SHA-1 de cada contraseña a Have I Been Pwned. Las contraseñas nunca salen de este Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งเฉพาะ 5 อักขระแรกของแฮช SHA-1 ของรหัสผ่านแต่ละรายการไปยัง Have I Been Pwned รหัสผ่านไม่ออกจาก Mac เครื่องนี้."
          }
        }
      }
    },
    "Sent unencrypted (http://)": {
