          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกคีย์ API อื่นในห้องนิรภัย หรือปลดล็อกบัญชีของคีย์นั้นเพื่อเพิ่มที่นี่"
          }
        }
      }
    },
    "Save references to this tool's keys. Key values stay in your vault.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
