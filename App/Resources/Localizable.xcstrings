    "Sign in again to sync this account. The saved vault is still available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again to sync this account. The saved vault is still available."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新登入以同步此帳戶。仍可使用已儲存的保管庫。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新登入去同步呢個帳戶。已儲存嘅保險庫仍然可以用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
