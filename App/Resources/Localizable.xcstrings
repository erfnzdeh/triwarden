        }
      }
    },
    "Values you copy or use appear here until the vault locks.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーまたは使用した値は、保管庫がロックされるまでここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你复制或使用的值会显示在这里，直到密码库锁定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你拷貝或使用的值會顯示在這裡，直到保險庫鎖定。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你複製或用過嘅值會顯示喺呢度，到保險庫鎖定為止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사하거나 사용한 값은 보관함이 잠길 때까지 여기에 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs que vous copiez ou utilisez apparaissent ici jusqu’au verrouillage du coffre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores que copias o usas aparecen aquí hasta que la caja fuerte se bloquee."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าที่คุณคัดลอกหรือใช้จะแสดงที่นี่จนกว่าห้องนิรภัยจะล็อก"
          }
        }
      }
    },
