    "Couldn't sync. The vault on this Mac is unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't sync. The vault on this Mac is unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期できませんでした。この Mac の保管庫はそのままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步失败。这台 Mac 上的保险库没有改动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步失敗。這台 Mac 上的保險庫沒有改動。"
