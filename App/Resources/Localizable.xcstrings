    },
    "You'll choose the tool and review its settings next.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にツールを選び、その設定を確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来你会选择工具并检查其设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來你會選擇工具並檢查其設定。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "跟住你會揀工具同檢查佢嘅設定。"
