    "Short or simple passwords are easy to guess. Generate a longer one.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い・単純なパスワードは推測されやすいです。長いものを生成しましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过短或过于简单的密码容易被猜中。请生成更长的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過短或過於簡單的密碼容易被猜中。請產生更長的密碼。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "太短或者太簡單嘅密碼好易畀人猜到。試下產生長啲嘅密碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧거나 단순한 비밀번호는 추측하기 쉽습니다. 더 긴 비밀번호를 생성하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots de passe courts ou simples sont faciles à deviner. Générez-en un plus long."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las contraseñas cortas o sencillas son fáciles de adivinar. Genera una más larga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านที่สั้นหรือเรียบง่ายเดาได้ง่าย สร้างรหัสที่ยาวขึ้น."
          }
        }
      }
    },
