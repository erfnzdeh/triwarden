    "It checks the practice key without printing it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習用キーを表示せずに確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会检查练习密钥，但不会显示其内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會檢查練習金鑰，但不會顯示其內容。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "佢會檢查練習密鑰，但唔會顯示內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습용 키를 출력하지 않고 확인합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vérifie la clé d'entraînement sans l'afficher."
          }
        },
        "es": {
