    "Too many wrong PINs, so the PIN is off. Use your master password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN の誤入力が多すぎたため、PIN をオフにしました。マスターパスワードを使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN 码错误次数过多，已停用 PIN 码。请使用主密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN 碼錯誤次數過多，已停用 PIN 碼。請使用主密碼。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN 碼錯得太多次，已經關咗 PIN 碼。請用主密碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN을 너무 많이 잘못 입력하여 PIN이 꺼졌습니다. 마스터 비밀번호를 사용하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de PIN incorrects, le PIN est donc désactivé. Utilisez votre mot de passe principal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados PIN incorrectos, así que el PIN está desactivado. Usa tu contraseña maestra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อน PIN ผิดหลายครั้งเกินไป PIN จึงถูกปิด ใช้รหัสผ่านหลัก"
