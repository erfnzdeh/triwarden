    "In Trash until %@, when Bitwarden deletes it for good. Restore it to use it again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱にあります。%@ に Bitwarden が完全に削除します。元に戻すと再び使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在废纸篓中，Bitwarden 将于 %@ 永久删除。恢复即可再次使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在垃圾桶中，Bitwarden 將於 %@ 永久刪除。還原即可再次使用。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺垃圾桶入面，Bitwarden 會喺 %@ 永久刪走佢。還原返就可以再用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@까지 휴지통에 있으며, 그때 Bitwarden이 완전히 삭제합니다. 다시 사용하려면 복원하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la corbeille jusqu'à %@, moment où Bitwarden le supprime définitivement. Restaurez-le pour l'utiliser à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la papelera hasta %@, cuando Bitwarden lo elimina de forma definitiva. Restáurelo para volver a usarlo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่ในถังขยะจนถึง %@ เมื่อถึงเวลานั้น Bitwarden จะลบถาวร กู้คืนเพื่อใช้งานอีกครั้ง"
          }
        }
      }
    },
    "In Trash. Restore it to use it again, or delete it forever.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱にあります。復元して再び使うか、完全に削除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于废纸篓。恢复后即可再次使用，或将其永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位於垃圾桶。還原後即可再次使用，或將其永久刪除。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺垃圾桶入面。還原返就可以再用，或者永久刪走佢。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에 있습니다. 다시 사용하려면 복원하거나, 완전히 삭제하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la corbeille. Restaurez-le pour l'utiliser à nouveau, ou supprimez-le définitivement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la papelera. Restáurelo para volver a usarlo, o elimínelo para siempre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่ในถังขยะ กู้คืนเพื่อใช้งานอีกครั้ง หรือลบถาวร"
          }
        }
      }
    },
