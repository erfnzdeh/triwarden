          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "數值要喺 5 至 128 之間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값은 5에서 128 사이여야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur doit être comprise entre 5 et 128."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor debe estar entre 5 y 128."
          }
        },
        "th": {
