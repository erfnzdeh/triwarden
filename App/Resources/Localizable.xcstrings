        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถาม GitHub เพียงหมายเลขรุ่นล่าสุด ไม่มีการดาวน์โหลดหรือติดตั้งให้"
          }
        }
      }
    },
    "Only if your services live on different URLs. Leave a field empty to use the server URL.": {
      "localizations": {
