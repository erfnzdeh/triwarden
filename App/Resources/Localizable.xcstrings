    "Every feature is free, with no time limit. A license is a one-time purchase that ends the weekly reminder and keeps the project going." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての機能が無料で、期限もありません。ライセンスは買い切りで、毎週のお知らせがなくなり、開発の支えになります。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有功能都免費，冇時間限制。授權係一次性買斷，買咗之後唔會再每星期提醒，仲可以支持項目繼續發展。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有功能都免费，没有时间限制。授权为一次性买断，购买后不再每周提醒，并支持项目持续发展。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有功能都免費，沒有時間限制。授權為一次性買斷，購買後不再每週提醒，並支持專案持續發展。"
          }
        }
      }
