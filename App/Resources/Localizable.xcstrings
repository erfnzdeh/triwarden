    "Using the system's trusted certificates.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが信頼する証明書を使用しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用系统信任的证书。"
          }
        },
        "zh-Hant": {
