    "Add a code secret to a login to see it here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインにコードのシークレットを追加すると、ここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在登录项中添加验证码密钥后，就会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在登入項目加入驗證碼密鑰後，就會顯示在這裡。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺登入項目加入驗證碼密鑰之後，就會顯示喺呢度。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인에 코드 시크릿을 추가하면 여기에 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un secret de code à un identifiant pour le voir ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un secreto de código a un inicio de sesión para verlo aquí."
