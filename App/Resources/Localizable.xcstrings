      }
    },
    "Discard tool setup?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールの設定を破棄しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要放弃工具设置吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要放棄工具設定嗎？"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "要放棄工具設定嗎？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 설정을 버릴까요?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner la configuration de l'outil ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descartar la configuración de la herramienta?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ละทิ้งการตั้งค่าเครื่องมือหรือไม่"
          }
        }
      }
    },
    "Each approval covers one saved tool started from one terminal window. Keys already delivered stay with the program.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 回の承認は、1 つのターミナルウインドウから起動した 1 つの保存済みツールに適用されます。すでに渡したキーはプログラムに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次批准只适用于从单一终端窗口启动的单一已保存工具。已交付的密钥会留在该程序中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次核准只適用於從單一終端機視窗啟動的單一已儲存工具。已交付的金鑰會留在該程式中。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每次批准只適用於喺同一個終端機視窗啟動嘅同一個已儲存工具。已經交咗出去嘅密鑰會留喺嗰個程式度。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 승인은 하나의 터미널 윈도우에서 시작한 하나의 저장된 도구에 적용됩니다. 이미 전달된 키는 프로그램에 남습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque autorisation couvre un outil enregistré lancé depuis une fenêtre de terminal. Les clés déjà transmises restent dans le programme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada aprobación cubre una herramienta guardada iniciada desde una ventana de terminal. Las claves ya entregadas se quedan en el programa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอนุมัติแต่ละครั้งครอบคลุมเครื่องมือที่บันทึกไว้หนึ่งรายการที่เริ่มจากหน้าต่างเทอร์มินัลหนึ่งหน้าต่าง คีย์ที่ส่งไปแล้วจะยังอยู่กับโปรแกรม"
          }
        }
      }
    },
    "Each key becomes an API key item, such as “%@ · %@”.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーは「%@ · %@」のような API キー項目になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个密钥会成为一个 API 密钥项目，例如“%@ · %@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每把金鑰會成為一個 API 金鑰項目，例如「%@ · %@」。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每條密鑰會變成一個 API 密鑰項目，例如「%@ · %@」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 키는 “%@ · %@” 같은 API 키 항목이 됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque clé devient un élément Clé d'API, comme « %@ · %@ »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada clave se convierte en un elemento Clave de API, como «%@ · %@»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละคีย์จะกลายเป็นรายการคีย์ API เช่น “%@ · %@”"
          }
        }
      }
    },
    "Each time an app asks to sign with an SSH key, the request and its outcome appear here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが SSH 鍵での署名を要求するたびに、その要求と結果がここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每当有 App 要求使用 SSH 密钥签名时，请求及其结果都会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每當有 App 要求使用 SSH 金鑰簽署時，請求及其結果都會顯示在這裡。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每次有 App 要求用 SSH 密鑰簽署，請求同結果都會喺呢度顯示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 SSH 키로 서명을 요청할 때마다 요청과 그 결과가 여기에 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fois qu'une app demande à signer avec une clé SSH, la demande et son résultat apparaissent ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que una app pide firmar con una clave SSH, la solicitud y su resultado aparecen aquí."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกครั้งที่แอปขอลงนามด้วยคีย์ SSH คำขอและผลลัพธ์จะแสดงที่นี่"
          }
        }
