    "Only asks GitHub for the latest release number. Nothing is downloaded or installed for you.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub に最新のリリース番号を問い合わせるだけで、自動でダウンロードやインストールはしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会向 GitHub 查询最新版本号，不会自动下载或安装任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會向 GitHub 查詢最新版本號，不會自動下載或安裝任何東西。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只會向 GitHub 查詢最新版本號，唔會自動下載或安裝任何嘢。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에 최신 릴리스 번호만 확인합니다. 다운로드하거나 설치하지는 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
