          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少密鑰：請喺「機密資料」開啟呢個工具，再揀過條密鑰。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 없습니다: '보안 정보'에서 도구를 열고 키를 다시 선택하세요."
          }
        },
        "fr": {
