    "This item type is not supported yet. Use an updated Bitwarden client to make changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item type is not supported yet. Use an updated Bitwarden client to make changes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前尚未支援此項目類型。請使用已更新的 Bitwarden 用戶端進行變更。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時未支援呢種項目類型。請用更新咗嘅 Bitwarden 用戶端修改。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前尚不支持此项目类型。请使用已更新的 Bitwarden 客户端进行修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この種類の項目にはまだ対応していません。変更するには、更新済みの Bitwarden クライアントを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목 유형은 아직 지원되지 않습니다. 변경하려면 업데이트된 Bitwarden 클라이언트를 사용하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce type d'élément n'est pas encore pris en charge. Utilisez un client Bitwarden à jour pour effectuer les modifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tipo de elemento aún no es compatible. Usa un cliente de Bitwarden actualizado para hacer cambios."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่รองรับประเภทรายการนี้ ใช้ไคลเอนต์ Bitwarden ที่อัปเดตแล้วเพื่อทำการเปลี่ยนแปลง"
          }
        }
      }
    },
    "This vault contains an unsupported item type. Export it with an updated Bitwarden client to preserve all data.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This vault contains an unsupported item type. Export it with an updated Bitwarden client to preserve all data."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此保管庫包含不支援的項目類型。請使用已更新的 Bitwarden 用戶端匯出，以保留所有資料。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個保險庫有唔支援嘅項目類型。請用更新咗嘅 Bitwarden 用戶端匯出，保留晒所有資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密码库包含不支持的项目类型。请使用已更新的 Bitwarden 客户端导出，以保留所有数据。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この保管庫には未対応の種類の項目があります。すべてのデータを保持するには、更新済みの Bitwarden クライアントでエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 보관함에는 지원되지 않는 항목 유형이 있습니다. 모든 데이터를 보존하려면 업데이트된 Bitwarden 클라이언트로 내보내세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce coffre contient un type d'élément non pris en charge. Exportez-le avec un client Bitwarden à jour pour conserver toutes les données."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta caja fuerte contiene un tipo de elemento no compatible. Expórtala con un cliente de Bitwarden actualizado para conservar todos los datos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องนิรภัยนี้มีประเภทรายการที่ไม่รองรับ ส่งออกด้วยไคลเอนต์ Bitwarden ที่อัปเดตแล้วเพื่อเก็บข้อมูลทั้งหมดไว้"
          }
        }
      }
    },
