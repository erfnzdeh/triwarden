    },
    "No weak, reused or unsecured passwords. Check for breaches to be sure.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弱い・使い回し・安全でないパスワードはありません。念のため漏えいも確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有弱、重复或不安全的密码。检查一下是否泄露会更放心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有弱、重複或不安全的密碼。檢查一下是否外洩會更安心。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "冇弱、重複同埋唔安全嘅密碼。檢查下有冇外洩會更安心。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취약하거나 재사용되거나 보호되지 않은 비밀번호가 없습니다. 확실하려면 유출 여부를 확인하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mot de passe faible, réutilisé ou non sécurisé. Vérifiez les fuites pour en être sûr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay contraseñas débiles, reutilizadas o sin protección. Compruebe las filtraciones para estar seguro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรหัสผ่านที่อ่อนแอ ใช้ซ้ำ หรือไม่ปลอดภัย ตรวจการรั่วไหลเพื่อความแน่ใจ"
          }
        }
      }
    },
