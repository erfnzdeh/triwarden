            "state": "translated",
            "value": "ログインとセキュアメモのみ。表計算や他のパスワードマネージャ向け。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅包含登录信息和安全备忘录，适用于电子表格和其他密码管理器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
