    "Access shows every approval. End temporary access there at any time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アクセス」にすべての承認が表示されます。一時的なアクセスはそこからいつでも終了できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“访问权限”会列出每项批准，你可随时在那里结束暂时访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「存取權限」會列出每項核准，你可隨時在那裡結束暫時存取。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「存取權限」會列出每項批准，你隨時都可以喺嗰度結束暫時存取。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'접근'에 모든 승인이 표시됩니다. 임시 접근은 언제든지 그곳에서 종료할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès affiche chaque autorisation. Mettez-y fin à un accès temporaire à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso muestra cada aprobación. Finaliza ahí el acceso temporal en cualquier momento."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงจะแสดงการอนุมัติทั้งหมด คุณสิ้นสุดการเข้าถึงชั่วคราวได้ที่นั่นทุกเมื่อ"
          }
        }
      }
    },
