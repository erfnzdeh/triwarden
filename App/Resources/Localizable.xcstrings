          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "佢會連結去呢份 Triwarden。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Triwarden 사본에 연결됩니다."
          }
        },
