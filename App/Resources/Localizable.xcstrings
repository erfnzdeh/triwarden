    },
    "Already have a license?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライセンスをお持ちですか？"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已經有授權？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
