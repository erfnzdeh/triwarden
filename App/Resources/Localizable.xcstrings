    "Value must be between 3 and 20. Use 6 words or more to generate a strong passphrase.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3〜20 の値にしてください。強いパスフレーズには 6 語以上を使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值须介于 3 到 20。使用 6 个或更多单词可生成强密码短语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數值須介於 3 到 20。使用 6 個字以上可產生強密語。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "數值要喺 3 至 20 之間。用 6 個字或以上就可以產生強密語。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값은 3에서 20 사이여야 합니다. 강한 암호 구문을 만들려면 6개 이상의 단어를 사용하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur doit être comprise entre 3 et 20. Utilisez 6 mots ou plus pour générer une phrase secrète robuste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor debe estar entre 3 y 20. Usa 6 palabras o más para generar una frase de contraseña segura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าต้องอยู่ระหว่าง 3 ถึง 20 ใช้ตั้งแต่ 6 คำขึ้นไปเพื่อสร้างวลีรหัสผ่านที่รัดกุม"
          }
        }
      }
    },
    "Value must be between 5 and 128.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5〜128 の値にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值须介于 5 到 128。"
          }
        },
