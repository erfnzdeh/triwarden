    "Watch the tool's output to see that it started.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールの出力を見て、起動したことを確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
