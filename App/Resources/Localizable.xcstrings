    "Signed in as %@. Your master password decrypts the vault on this Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ としてサインインしました。マスターパスワードでこの Mac 上の保管庫を復号します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已以 %@ 登录。你的主密码会在这台 Mac 上解密密码库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已以 %@ 登入。你的主密碼會在這部 Mac 上解密保險庫。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已用 %@ 登入。你嘅主密碼會喺呢部 Mac 上解密保險庫。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 계정으로 로그인했습니다. 마스터 비밀번호로 이 Mac의 보관함을 복호화합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté en tant que %@. Votre mot de passe principal déchiffre le coffre sur ce Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión iniciada como %@. Tu contraseña maestra descifra la caja fuerte en este Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าสู่ระบบในชื่อ %@ รหัสผ่านหลักจะถอดรหัสห้องนิรภัยบน Mac เครื่องนี้"
          }
        }
      }
    },
