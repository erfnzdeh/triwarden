          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 도구에 필요한 키만 추가하세요. 키마다 서로 다른 환경 변수를 사용해야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez uniquement les clés dont cet outil a besoin. Chaque clé doit utiliser une variable d'environnement différente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
