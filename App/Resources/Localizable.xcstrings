    "Done. Two-step login is on, so this Mac needs a code: log out and sign in again to keep syncing." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了しました。2 段階ログインが有効なため、この Mac にはコードが必要です。同期を続けるにはログアウトして再度サインインしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
