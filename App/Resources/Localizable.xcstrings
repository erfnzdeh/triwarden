    "Unlock this account once to set a PIN.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN を設定するには、このアカウントを一度ロック解除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先解锁此账户一次才能设置 PIN 码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先解鎖此帳號一次才能設定 PIN 碼。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "要先解鎖呢個帳戶一次先可以設定 PIN 碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN을 설정하려면 이 계정을 한 번 잠금 해제하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez ce compte une fois pour définir un PIN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea esta cuenta una vez para definir un PIN."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลดล็อกบัญชีนี้หนึ่งครั้งเพื่อตั้ง PIN"
          }
        }
      }
    },
    "Unlock this account once to turn it on.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にするには、このアカウントを一度ロック解除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
