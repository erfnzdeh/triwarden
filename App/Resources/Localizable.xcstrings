    "Only asks GitHub for the latest release number. Nothing is downloaded or installed for you.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub に最新のリリース番号を問い合わせるだけで、自動でダウンロードやインストールはしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会向 GitHub 查询最新版本号，不会自动下载或安装任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會向 GitHub 查詢最新版本號，不會自動下載或安裝任何東西。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只會向 GitHub 查詢最新版本號，唔會自動下載或安裝任何嘢。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에 최신 릴리스 번호만 확인합니다. 다운로드하거나 설치하지는 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroge GitHub uniquement pour le numéro de la dernière version. Rien n’est téléchargé ni installé pour vous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo consulta a GitHub el número de la última versión. No se descarga ni se instala nada por usted."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถาม GitHub เพียงหมายเลขรุ่นล่าสุด ไม่มีการดาวน์โหลดหรือติดตั้งให้"
          }
        }
      }
    },
    "Only if your services live on different URLs. Leave a field empty to use the server URL.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスが別の URL にある場合のみ。空欄ならサーバ URL を使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你的服务位于不同网址时需要。留空则使用服务器网址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你的服務位於不同網址時才需要。留空則使用伺服器網址。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只係你啲服務喺唔同網址先需要。留空就用伺服器網址。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스가 서로 다른 URL에 있을 때만 입력하세요. 칸을 비워 두면 서버 URL을 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement si vos services sont sur des URL différentes. Laissez un champ vide pour utiliser l’URL du serveur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo si sus servicios están en URL distintas. Deje un campo vacío para usar la URL del servidor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เมื่อบริการอยู่คนละ URL เท่านั้น เว้นช่องว่างไว้เพื่อใช้ URL ของเซิร์ฟเวอร์"
          }
        }
      }
    },
