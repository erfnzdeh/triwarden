    "SSH key items from unlocked accounts are offered to ssh and git. Each signature asks you, then asks macOS for Touch ID or your Mac login password. Keys never leave the app." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "SSH key items from unlocked accounts are offered to ssh and git. Each signature asks you, then asks macOS for Touch ID or your Mac login password. Keys never leave the app." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ロック解除中のアカウントの SSH 鍵を ssh と git に渡します。署名のたびに確認し、そのあと macOS が Touch ID またはこの Mac のログインパスワードを求めます。鍵がアプリの外に出ることはありません。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已解锁账户里的 SSH 密钥会提供给 ssh 和 git。每次签名都会先问你，再由 macOS 要求 Touch ID 或这台 Mac 的登录密码。密钥不会离开这个 app。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已解鎖帳戶裡的 SSH 金鑰會提供給 ssh 和 git。每次簽名都會先問你，再由 macOS 要求 Touch ID 或這台 Mac 的登入密碼。金鑰不會離開這個 app。" } },
        "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "已解鎖帳戶裡的 SSH 金鑰會提供給 ssh 和 git。每次簽名都會先問你，再由 macOS 要求 Touch ID 或這部 Mac 的登入密碼。金鑰不會離開這個 app。" } }
      }
    },
