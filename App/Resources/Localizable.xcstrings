    "Items stay here until you delete them, unless your server's admin set it to empty the Trash after a while." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの管理者が一定期間後にゴミ箱を空にする設定をしていない限り、削除するまでここに残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目会一直保留在此，直到你删除为止，除非服务器管理员设置了一段时间后自动清空废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目會一直保留在此，直到你刪除為止，除非伺服器管理員設定了一段時間後自動清空垃圾桶。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目會一直留喺度，直到你刪除為止，除非伺服器管理員設定咗一段時間之後自動清空垃圾桶。"
          }
        }
      }
    },
