    },
    "Share text or a file through an encrypted link that expires.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限付きの暗号化リンクでテキストやファイルを共有します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过会失效的加密链接分享文字或文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過會失效的加密連結分享文字或檔案。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用會失效嘅加密連結分享文字或檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만료되는 암호화 링크로 텍스트나 파일을 공유합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez un texte ou un fichier via un lien chiffré qui expire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte un texto o un archivo mediante un enlace cifrado que caduca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ข้อความหรือไฟล์ผ่านลิงก์ที่เข้ารหัสและหมดอายุ."
          }
        }
      }
    },
    "Share text or a file with anyone through an encrypted link that expires.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限付きの暗号化リンクで、テキストやファイルを誰とでも共有できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过会过期的加密链接，与任何人分享文字或文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過會到期的加密連結，與任何人分享文字或檔案。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用會失效嘅加密連結，同任何人分享文字或者檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만료되는 암호화 링크로 누구에게나 텍스트나 파일을 공유합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez un texte ou un fichier avec n'importe qui via un lien chiffré qui expire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte un texto o un archivo con cualquier persona mediante un enlace cifrado que caduca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ข้อความหรือไฟล์กับใครก็ได้ผ่านลิงก์ที่เข้ารหัสและหมดอายุ."
          }
        }
      }
    },
    "Share these items with the shared vault's members.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの項目を共有保管庫のメンバーと共有します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与共享保险库的成员共享这些项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與共享保險庫的成員共享這些項目。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將呢啲項目分享畀共享保險庫嘅成員。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목들을 공유 보관함의 구성원과 공유합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez ces éléments avec les membres du coffre partagé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte estos elementos con los miembros de la caja fuerte compartida."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์รายการเหล่านี้กับสมาชิกของห้องนิรภัยที่แชร์."
          }
        }
      }
    },
    "Share this item with the shared vault's members.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目を共有保管庫のメンバーと共有します。"
          }
        },
        "zh-Hans": {
