            "value": "สร้าง Send"
          }
        }
      }
    },
    "Hide passphrase": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide passphrase"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスフレーズを隠す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏口令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏口令"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏口令"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호 문구 가리기"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer la phrase secrète"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar frase de contraseña"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนวลีรหัสผ่าน"
          }
        }
      }
    },
    "Send it to the recipient another way, not in the same message as the link.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send it to the recipient another way, not in the same message as the link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクとは別の方法で受信者に伝えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请通过链接以外的另一种方式发给收件人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請透過連結以外的另一種方式傳給收件人。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用連結以外嘅另一個方法俾收件人。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크와 다른 방법으로 받는 사람에게 전달하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmettez-la au destinataire autrement, pas dans le même message que le lien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíala al destinatario por otra vía, no en el mismo mensaje que el enlace."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งให้ผู้รับด้วยช่องทางอื่น ไม่ใช่ข้อความเดียวกับลิงก์"
          }
        }
      }
    },
    "Send this passphrase to the recipient another way. Without it, the link won't open.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this passphrase to the recipient another way. Without it, the link won't open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパスフレーズは別の方法で受信者に伝えてください。これがないとリンクは開けません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请通过其他方式把这个口令发给收件人。没有它，链接打不开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請透過其他方式把這個口令傳給收件人。沒有它，連結打不開。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請用其他方法將呢個口令俾收件人。冇咗佢，條連結開唔到。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 암호 문구는 다른 방법으로 받는 사람에게 전달하세요. 없으면 링크가 열리지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmettez cette phrase secrète au destinataire par un autre canal. Sans elle, le lien ne s'ouvre pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía esta frase de contraseña al destinatario por otra vía. Sin ella, el enlace no se abre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งวลีรหัสผ่านนี้ให้ผู้รับผ่านช่องทางอื่น หากไม่มี ลิงก์จะเปิดไม่ได้"
          }
        }
      }
    },
