    "Drag the status to put it anywhere. Choose another position to move it back.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状況表示はドラッグして好きな場所に置けます。別の位置を選ぶと元に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动状态即可放到任意位置。选择其他位置即可移回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳狀態即可放到任意位置。選擇其他位置即可移回。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "拖個狀態就可以放去任何位置。揀返另一個位置就會移返去。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태를 드래그해 원하는 곳에 둘 수 있습니다. 다른 위치를 선택하면 되돌아갑니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser l'état pour le placer n'importe où. Choisissez une autre position pour le remettre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el estado para colocarlo donde quieras. Elige otra posición para devolverlo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากสถานะไปวางตรงไหนก็ได้ เลือกตำแหน่งอื่นเพื่อย้ายกลับ"
          }
        }
      }
    },
    "%@ is using the notch, so the status shows at the top right instead.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がノッチを使用しているため、状況表示は右上に出ます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在使用刘海，所以状态改为显示在右上角。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在使用瀏海，所以狀態改為顯示在右上角。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 用緊瀏海，所以狀態改咗喺右上角顯示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 앱이 노치를 사용 중이므로 상태가 오른쪽 위에 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise l'encoche ; l'état s'affiche donc en haut à droite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está usando la muesca, así que el estado aparece arriba a la derecha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ กำลังใช้รอยบาก สถานะจึงแสดงที่ขวาบนแทน"
          }
        }
      }
    },
