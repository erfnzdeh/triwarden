    "That doesn't look like a valid one-time code secret.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なワンタイムコードのシークレットではないようです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来不是有效的一次性验证码密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這看起來不是有效的一次性驗證碼密鑰。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個睇落唔似有效嘅一次性驗證碼密匙。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효한 일회용 코드 비밀 값이 아닌 것 같습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas à un secret de code à usage unique valide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no parece un secreto de código de un solo uso válido."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่านี้ดูไม่เหมือนค่าลับของรหัสใช้ครั้งเดียวที่ถูกต้อง"
          }
        }
      }
    },
    "That file isn't a certificate.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは証明書ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件不是证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該檔案不是憑證。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個檔案唔係憑證。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 인증서가 아닙니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n'est pas un certificat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese archivo no es un certificado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นั้นไม่ใช่ใบรับรอง"
          }
        }
      }
    },
