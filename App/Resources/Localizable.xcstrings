    },
    "“%@” is no longer trusted; a server that relies on it stops connecting.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は信頼されなくなり、これに依存するサーバには接続できなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将不再受信任；依赖它的服务器将无法连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」將不再受信任；依賴它的伺服器將無法連線。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」之後唔再受信任；靠佢嘅伺服器會連唔到。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”는 더 이상 신뢰되지 않습니다. 이에 의존하는 서버는 연결이 중단됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n'est plus de confiance ; un serveur qui en dépend cesse de se connecter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya no es de confianza; un servidor que dependa de ello deja de conectarse."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
