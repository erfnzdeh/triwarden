          }
        }
      }
    },
    "A second step after your master password when you sign in on a new device. Keep the recovery code somewhere safe: it turns two-step login off if you lose every method.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいデバイスでサインインするとき、マスターパスワードの後の 2 段階目です。リカバリーコードは安全な場所に保管してください。すべての方法を失ったときに 2 段階ログインを無効にできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新设备登录时，主密码之后的第二步。请把恢复码保存在安全的地方：如果所有方式都丢失，它可以关闭两步登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在新裝置登入時，主密碼之後的第二步驟。請把復原碼存放在安全的地方：若失去所有方式，它能關閉兩步驟登入。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺新裝置登入時，主密碼之後嘅第二步。將復原碼放喺安全地方：如果所有方法都冇咗，可以用佢關閉兩步驟登入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 기기에서 로그인할 때 마스터 비밀번호 다음의 두 번째 단계입니다. 복구 코드를 안전한 곳에 보관하세요. 모든 수단을 잃으면 2단계 로그인을 끌 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une deuxième étape après votre mot de passe principal lorsque vous vous connectez sur un nouvel appareil. Conservez le code de récupération en lieu sûr : il désactive la connexion en deux étapes si vous perdez toutes les méthodes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un segundo paso después de tu contraseña maestra al iniciar sesión en un dispositivo nuevo. Guarda el código de recuperación en un lugar seguro: desactiva el inicio de sesión en dos pasos si pierdes todos los métodos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขั้นตอนที่สองหลังรหัสผ่านหลัก เมื่อเข้าสู่ระบบบนอุปกรณ์ใหม่ เก็บรหัสกู้คืนไว้ในที่ปลอดภัย จะใช้ปิดการเข้าสู่ระบบสองขั้นตอนได้หากสูญเสียทุกวิธี"
          }
        }
      }
    },
    "A short PIN instead of the master password. Five wrong tries turn it off.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスターパスワードの代わりに短い PIN を使います。5 回間違えるとオフになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以简短的 PIN 码代替主密码。输错五次即会停用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以簡短的 PIN 碼代替主密碼。輸錯五次即會停用。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用簡短嘅 PIN 碼代替主密碼。輸錯五次就會停用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스터 비밀번호 대신 사용하는 짧은 PIN입니다. 다섯 번 틀리면 꺼집니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un court PIN à la place du mot de passe principal. Cinq essais incorrects le désactivent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un PIN corto en lugar de la contraseña maestra. Cinco intentos incorrectos lo desactivan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN สั้นที่ใช้แทนรหัสผ่านหลัก หากป้อนผิดห้าครั้งจะปิดการใช้งาน"
          }
        }
      }
    },
