          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把密钥添加到你的身份验证器 App，再输入它显示的验证码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把金鑰加入你的驗證器 App，再輸入它顯示的驗證碼。"
          }
