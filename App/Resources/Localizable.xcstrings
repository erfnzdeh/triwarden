    "Encrypted on this Mac before anything is sent.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信前にすべてこの Mac で暗号化されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有数据都会先在这台 Mac 上加密再发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有資料都會先在這台 Mac 上加密才傳送。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "所有資料都會喺呢部 Mac 加密咗先傳送。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이든 전송되기 전에 이 Mac에서 암호화됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffré sur ce Mac avant tout envoi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrado en este Mac antes de enviar nada."
          }
        },
