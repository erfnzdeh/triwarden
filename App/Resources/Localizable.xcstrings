    "Unchanged for three years or more. No need to change a strong, unique one; worth it for an account that matters." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3年以上変更されていません。強力で使い回していないものは変える必要はありませんが、大切なアカウントは見直す価値があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三年或以上未更改。强而独一无二的密码不必更改；重要的账户值得换一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三年或以上未更改。強而獨一無二的密碼不必更改；重要的帳號值得換一個。"
