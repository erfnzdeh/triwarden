    "Someone with an account on this server who can ask for access in an emergency.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーにアカウントがあり、緊急時にアクセスを申請できる人。"
          }
        },
