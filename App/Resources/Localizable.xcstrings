    "“%@” is larger than 500 MB.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は 500 MB を超えています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”超过 500 MB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
