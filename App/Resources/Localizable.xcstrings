    "Pick a recipe, then check the program and folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートを選び、プログラムとフォルダを確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个模板，然后检查程序和文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個範本，然後檢查程式和資料夾。"
          }
        },
        "zh-HK": {
