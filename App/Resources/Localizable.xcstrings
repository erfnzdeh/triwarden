          }
        }
      }
    },
    "From the site's two-factor setup: scan its QR code, or paste the otpauth:// link or the key under it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイトの2ステップ認証の設定画面から：QR コードを読み取るか、otpauth:// リンクやその下のキーを貼り付けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自网站的两步验证设置：扫描它的二维码，或粘贴 otpauth:// 链接或二维码下方的密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
