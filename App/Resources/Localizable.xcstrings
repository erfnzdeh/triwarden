            "value": "終端機輔助程式"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 도우미"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistant de terminal"
          }
        },
        "es": {
