    "Removes the account and its saved vault from this Mac. Your data stays on the server.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac からアカウントと保存された保管庫を削除します。データはサーバーに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这台 Mac 移除账户及其保存的密码库。你的数据仍保留在服务器上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從這部 Mac 移除帳號及其儲存的保險庫。你的資料仍保留在伺服器上。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺呢部 Mac 移除帳戶同埋儲存咗嘅保險庫。你嘅資料會繼續留喺伺服器。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 계정과 저장된 보관함을 제거합니다. 데이터는 서버에 남습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire le compte et son coffre enregistré de ce Mac. Vos données restent sur le serveur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita la cuenta y su caja fuerte guardada de este Mac. Tus datos permanecen en el servidor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำบัญชีและห้องนิรภัยที่บันทึกไว้ออกจาก Mac เครื่องนี้ ข้อมูลของคุณยังอยู่บนเซิร์ฟเวอร์."
          }
        }
      }
