    "Ask them to read their fingerprint phrase (Settings › Accounts). Confirm only if it matches.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手にフィンガープリントフレーズ（設定 › アカウント）を読み上げてもらい、一致した場合のみ確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请对方读出他们的指纹短语（设置 › 账户），相符时才确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請對方念出他們的指紋短語（設定 › 帳號），相符時才確認。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "叫對方讀出佢哋嘅指紋短語（設定 › 帳戶），一致先確認。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대에게 지문 문구(설정 › 계정)를 읽어 달라고 하세요. 일치할 때만 확인하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez-leur de lire leur phrase d’empreinte (Réglages › Comptes). Ne confirmez que si elle correspond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídeles que lean su frase de huella (Ajustes › Cuentas). Confirma solo si coincide."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้ผู้นั้นอ่านวลีลายนิ้วมือ (การตั้งค่า › บัญชี) ยืนยันเฉพาะเมื่อตรงกัน"
          }
        }
      }
    },
