            "state": "translated",
            "value": "圖示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Icônes"
          }
        },
        "es": {
          "stringUnit": {
