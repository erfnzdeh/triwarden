          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "佢嘅子資料夾會一齊搬。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 폴더도 함께 이동합니다."
          }
