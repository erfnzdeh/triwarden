{
  "sourceLanguage": "en",
  "strings": {
    "Copy the link now — you can also find it again on the Send.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the link now — you can also find it again on the Send."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐリンクをコピーしてください — Send を開けばいつでも確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在复制链接 —— 之后打开这个 Send 也能找到它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在複製連結 —— 之後開啟這個 Send 也能找到它。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "而家複製連結 —— 之後開返呢個 Send 都搵得返。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 링크를 복사하세요 — 나중에 Send를 열면 다시 볼 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez le lien maintenant — vous le retrouverez aussi sur le Send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia el enlace ahora — también lo encontrarás en el Send."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกลิงก์ตอนนี้ — เปิด Send นี้แล้วก็ยังหาเจอได้"
          }
        }
      }
    },
