    "At least 12 characters. A long passphrase is easiest to remember.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12 文字以上。長いパスフレーズが一番覚えやすいです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 12 个字符。长的密码短语最容易记住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 12 個字元。長的密碼短語最容易記住。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 12 個字元。長嘅密碼短語最易記。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12자 이상. 긴 암호 구문이 가장 기억하기 쉽습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins 12 caractères. Une longue phrase secrète est la plus facile à retenir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos 12 caracteres. Una frase de contraseña larga es lo más fácil de recordar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่างน้อย 12 อักขระ วลีรหัสผ่านที่ยาวจดจำได้ง่ายที่สุด"
          }
        }
      }
    },
