            "state": "translated",
            "value": "สคริปต์จะตรวจสอบคีย์ฝึกใช้โดยไม่แสดงค่าออกมา"
          }
        }
      }
    },
    "It links /usr/local/bin/tw to the helper in this app. It replaces only an existing link, never a file.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/usr/local/bin/tw をこのアプリ内のヘルパーにリンクします。置き換えるのは既存のリンクだけで、ファイルは置き換えません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会将 /usr/local/bin/tw 链接到这个 App 内的辅助程序。只会取代既有的链接，绝不会取代文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會將 /usr/local/bin/tw 連結到這個 App 內的輔助程式。只會取代既有的連結，絕不會取代檔案。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "佢會將 /usr/local/bin/tw 連結去呢個 App 入面嘅輔助程式。只會取代現有嘅連結，永遠唔會取代檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/usr/local/bin/tw를 이 앱의 도우미에 연결합니다. 기존 링크만 바꾸며 파일은 절대 바꾸지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il relie /usr/local/bin/tw à l'assistant de cette app. Il remplace uniquement un lien existant, jamais un fichier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlaza /usr/local/bin/tw con el asistente de esta app. Solo reemplaza un enlace existente, nunca un archivo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์ /usr/local/bin/tw ไปยังตัวช่วยในแอปนี้ จะแทนที่เฉพาะลิงก์ที่มีอยู่ ไม่แทนที่ไฟล์"
          }
        }
      }
    },
    "It links to this copy of Triwarden.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Triwarden のコピーにリンクします。"
