          }
        }
      }
    },
    "That's a Google Authenticator export. Show the site's own QR code instead.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは Google Authenticator のエクスポートです。代わりにサイト自身の QR コードを表示してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 Google Authenticator 的导出内容。请改为显示网站自己的二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是 Google Authenticator 的匯出內容。請改為顯示網站本身的 QR 碼。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
