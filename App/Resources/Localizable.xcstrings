    "Use / to nest, e.g. Work/Servers.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/ で入れ子にできます（例：仕事/サーバー）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 / 创建子文件夹，例如 工作/服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 / 建立子資料夾，例如 工作/伺服器。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用 / 建立子資料夾，例如 工作/伺服器。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/로 중첩할 수 있습니다. 예: 업무/서버."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez / pour imbriquer, p. ex. Travail/Serveurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa / para anidar, p. ej. Trabajo/Servidores."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ / เพื่อซ้อนกัน เช่น งาน/เซิร์ฟเวอร์"
          }
        }
      }
    },
    "Use https:// for servers on the internet. http:// is only allowed on your local network.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネット上のサーバーには https:// を使ってください。http:// はローカルネットワークでのみ使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "互联网上的服务器请使用 https://，http:// 只允许用于局域网。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網際網路上的伺服器請使用 https://，http:// 只允許用於區域網路。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "互聯網上嘅伺服器請用 https://，http:// 只可以喺你嘅區域網絡用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷의 서버에는 https://를 사용하세요. http://는 로컬 네트워크에서만 허용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez https:// pour les serveurs sur internet. http:// n’est autorisé que sur votre réseau local."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa https:// para los servidores en internet. http:// solo se permite en tu red local."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ https:// สำหรับเซิร์ฟเวอร์บนอินเทอร์เน็ต http:// ใช้ได้เฉพาะบนเครือข่ายภายในของคุณ"
          }
        }
      }
    },
