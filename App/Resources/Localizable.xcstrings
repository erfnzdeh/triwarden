    "Share by Link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share by Link"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクで共有"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过链接共享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過連結共享"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用連結分享"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크로 공유"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager par lien"
          }
        },
        "es": {
          "stringUnit": {
