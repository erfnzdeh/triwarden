    "Set a new master password for their account, then sign in to it with that password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のアカウントに新しいマスターパスワードを設定し、そのパスワードでサインインします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为对方的账户设置新的主密码，再用它登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為對方的帳號設定新的主密碼，再用它登入。"
