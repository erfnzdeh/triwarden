    "This signs one SSH operation. The private key stays in your vault.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs one SSH operation. The private key stays in your vault."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH の署名を 1 回行います。秘密鍵は保管庫に残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次只做一次 SSH 签名。私钥留在保险库里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次只做一次 SSH 簽名。私鑰留在保險庫裡。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢次只做一次 SSH 簽名。私鑰會留喺保險庫入面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 작업 하나에 서명합니다. 개인 키는 보관함에 남습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci signe une opération SSH. La clé privée reste dans votre coffre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto firma una operación SSH. La clave privada permanece en tu caja fuerte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือการลงนามการทำงาน SSH หนึ่งครั้ง คีย์ส่วนตัวยังอยู่ในห้องนิรภัยของคุณ"
          }
        }
      }
    },
    "This app has asked to sign before.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app has asked to sign before."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは以前にも署名を求めています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
