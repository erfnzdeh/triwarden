    "Aider works with many providers. Use the variable for yours, such as ANTHROPIC_API_KEY or OPENAI_API_KEY.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aider は多くのプロバイダに対応しています。ANTHROPIC_API_KEY や OPENAI_API_KEY など、使うプロバイダの変数を指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aider 支持多种服务商。请使用你所用服务商的变量，例如 ANTHROPIC_API_KEY 或 OPENAI_API_KEY。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Aider 支援多家服務供應商。請使用你所用供應商的變數，例如 ANTHROPIC_API_KEY 或 OPENAI_API_KEY。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
