          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita la cuenta y su caja fuerte guardada de este Mac. Tus datos permanecen en el servidor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำบัญชีและห้องนิรภัยที่บันทึกไว้ออกจาก Mac เครื่องนี้ ข้อมูลของคุณยังอยู่บนเซิร์ฟเวอร์."
          }
        }
      }
