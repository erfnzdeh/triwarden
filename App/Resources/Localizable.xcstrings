    "This item has nothing to share.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item has nothing to share."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目には共有できる内容がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目没有可共享的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此項目沒有可共享的內容。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個項目冇嘢可以分享。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목에는 공유할 내용이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément n'a rien à partager."
          }
        },
        "es": {
