          }
        }
      }
    },
    "You're set up. From now on it takes one command.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定が完了しました。今後はコマンド 1 つで起動できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
