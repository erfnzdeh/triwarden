          }
        }
      }
    },
    "Save another API key in your vault or unlock its account to add it here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに追加するには、別の API キーを保管庫に保存するか、そのアカウントのロックを解除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在保险库中保存其他 API 密钥，或解锁其账户，即可在此加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在保險庫中儲存其他 API 金鑰，或解鎖其帳號，即可在此加入。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺保險庫儲存另一條 API 密鑰，或者解鎖佢嘅帳戶，就可以喺呢度加入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 추가하려면 다른 API 키를 보관함에 저장하거나 해당 계정을 잠금 해제하세요."
          }
        },
        "fr": {
          "stringUnit": {
