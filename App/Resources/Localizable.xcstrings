    "Sign in again to sync this account. The saved vault is still available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again to sync this account. The saved vault is still available."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新登入以同步此帳戶。仍可使用已儲存的保管庫。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新登入去同步呢個帳戶。已儲存嘅保險庫仍然可以用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新登录以同步此账户。仍可使用已保存的密码库。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントを同期するには再度ログインしてください。保存済みの保管庫は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정을 동기화하려면 다시 로그인하세요. 저장된 보관함은 계속 사용할 수 있습니다."
          }
        },
        "fr": {
