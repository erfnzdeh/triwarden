    "Set a new master password for their account, then sign in to it with that password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のアカウントに新しいマスターパスワードを設定し、そのパスワードでサインインします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为对方的账户设置新的主密码，再用它登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為對方的帳號設定新的主密碼，再用它登入。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "幫對方帳戶設定新嘅主密碼，再用呢個密碼登入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 계정에 새 마스터 비밀번호를 설정한 다음, 그 비밀번호로 로그인하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un nouveau mot de passe principal pour son compte, puis connectez-vous avec ce mot de passe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece una nueva contraseña maestra para su cuenta e inicia sesión con esa contraseña."
          }
        },
        "th": {
