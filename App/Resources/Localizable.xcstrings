        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 비밀번호로 암호화됩니다. 권장: Bitwarden과 Triwarden에서 모든 기기로 가져올 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
