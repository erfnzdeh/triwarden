    "It's no longer sent, and its value is deleted from your Keychain.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後は送信されず、値はキーチェーンから削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将不再发送，其值也会从钥匙串中删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將不再傳送，其值也會從鑰匙圈中刪除。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "之後唔會再傳送，個值都會喺鑰匙圈刪走。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 전송되지 않으며, 값은 키체인에서 삭제됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'est plus envoyé, et sa valeur est supprimée de votre Trousseau."
          }
        },
        "es": {
