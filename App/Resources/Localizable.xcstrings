          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺顯示或者複製呢個項目嘅機密之前。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목의 비밀을 표시하거나 복사하기 전."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d’afficher ou de copier les secrets de cet élément."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de mostrar o copiar los secretos de este elemento."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
