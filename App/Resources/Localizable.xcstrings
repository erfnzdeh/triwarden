    "Triwarden uses the saved command and project folder. It asks for approval when required.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden は保存済みのコマンドとプロジェクトフォルダを使います。必要に応じて承認を求めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden 会使用已保存的命令和项目文件夹，并在需要时要求批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden 會使用已儲存的指令和專案資料夾，並在需要時要求核准。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden 會用已儲存嘅指令同項目資料夾，有需要時會要求批准。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden은 저장된 명령과 프로젝트 폴더를 사용합니다. 필요하면 승인을 요청합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden utilise la commande et le dossier de projet enregistrés. Il demande une autorisation si nécessaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden usa el comando y la carpeta de proyecto guardados. Pide aprobación cuando es necesario."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden ใช้คำสั่งและโฟลเดอร์โปรเจกต์ที่บันทึกไว้ และจะขออนุมัติเมื่อจำเป็น"
          }
        }
      }
    },
