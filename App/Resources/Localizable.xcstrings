    "Expired, or expiring in the next two months. Put the new card's dates in once it arrives.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限切れ、または2か月以内に期限切れになります。新しいカードが届いたら有効期限を更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已过期，或将在两个月内过期。新卡寄到后，填入新的有效期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已到期，或將在兩個月內到期。新卡寄到後，填入新的有效期限。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已經到期，或者兩個月內到期。新卡寄到之後，填返新嘅有效期。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만료되었거나 앞으로 두 달 안에 만료됩니다. 새 카드가 도착하면 날짜를 입력하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expirée, ou expire dans les deux prochains mois. Saisissez les dates de la nouvelle carte dès qu’elle arrive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caducada, o caduca en los próximos dos meses. Introduzca las fechas de la tarjeta nueva cuando llegue."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมดอายุแล้ว หรือจะหมดอายุภายในสองเดือนข้างหน้า เมื่อบัตรใหม่มาถึง ให้ใส่วันที่"
          }
        }
      }
    },
