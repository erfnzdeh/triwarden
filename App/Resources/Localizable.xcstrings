      }
    },
    "Copied secrets are marked as concealed, so clipboard managers skip them." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーした機密情報は非表示として扱われ、クリップボード管理ツールに記録されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷贝的机密信息会标记为隐藏，剪贴板管理工具不会记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷貝的機密資料會標記為隱藏，剪貼板管理工具不會記錄。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複製的機密資料會標記為隱藏，剪貼簿管理工具不會記錄。"
          }
        }
      }
    },
    "Copied secrets are marked as concealed, so clipboard managers skip them. Paste a login's password, and its one-time code is ready to paste next." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーした秘密情報は非表示として扱われ、クリップボード管理アプリには残りません。ログインのパスワードを貼り付けると、次はその確認コードを貼り付けられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷贝的机密内容会标记为隐藏，剪贴板管理工具不会记录。粘贴登录项的密码后，接着就能粘贴它的一次性验证码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷貝的機密內容會標記為隱藏，剪貼簿管理工具不會記錄。貼上登入項目的密碼後，接著就能貼上它的一次性驗證碼。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複製嘅機密內容會標記為隱藏，剪貼簿管理工具唔會記錄。貼上登入項目嘅密碼之後，跟住就可以貼上佢嘅一次性驗證碼。"
          }
        }
      }
    },
    "Copied the password for %@." : {
