    "For this account only; Default follows Settings › Security. Log out removes the account and its saved vault from this Mac." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントのみに適用されます。「デフォルト」は 設定 › セキュリティ に従います。ログアウトすると、この Mac からアカウントと保存された保管庫が削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅适用于此账户；“默认”跟随“设置 › 安全性”。注销会从这台 Mac 移除账户及其保存的密码库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
