          }
        }
      }
    },
    "Bitwarden": {
      "shouldTranslate": false
    },
    "Bitwarden asked for a captcha. Log in once at vault.bitwarden.com from this network, then try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden から CAPTCHA を求められました。このネットワークから一度 vault.bitwarden.com にログインしてから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden 要求人机验证。请先在此网络下登录一次 vault.bitwarden.com，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden 要求驗證碼挑戰。請先在這個網路下登入一次 vault.bitwarden.com，再重試。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden 要求驗證碼挑戰。請先喺呢個網路登入一次 vault.bitwarden.com，再試過。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden에서 CAPTCHA를 요청했습니다. 이 네트워크에서 vault.bitwarden.com에 한 번 로그인한 뒤 다시 시도하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden a demandé un captcha. Connectez-vous une fois sur vault.bitwarden.com depuis ce réseau, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden solicitó un captcha. Inicia sesión una vez en vault.bitwarden.com desde esta red y vuelve a intentarlo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitwarden ขอ captcha เข้าสู่ระบบที่ vault.bitwarden.com หนึ่งครั้งจากเครือข่ายนี้ แล้วลองอีกครั้ง"
          }
        }
      }
    },
