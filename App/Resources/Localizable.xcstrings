    "Search by name, username or website. Filter with type:card, is:favorite, has:otp, has:passkey, is:weak, folder:Work or vault:personal.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前、ユーザー名、Web サイトで検索。type:card、is:favorite、has:otp、has:passkey、is:weak、folder:Work、vault:personal で絞り込めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按名称、用户名或网站搜索。可用 type:card、is:favorite、has:otp、has:passkey、is:weak、folder:Work 或 vault:personal 筛选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依名稱、使用者名稱或網站搜尋。可用 type:card、is:favorite、has:otp、has:passkey、is:weak、folder:Work 或 vault:personal 篩選。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "按名稱、用戶名稱或者網站搜尋。可以用 type:card、is:favorite、has:otp、has:passkey、is:weak、folder:Work 或者 vault:personal 篩選。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름, 사용자 이름 또는 웹사이트로 검색합니다. type:card, is:favorite, has:otp, has:passkey, is:weak, folder:Work 또는 vault:personal로 필터링합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez par nom, nom d'utilisateur ou site web. Filtrez avec type:card, is:favorite, has:otp, has:passkey, is:weak, folder:Work ou vault:personal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca por nombre, nombre de usuario o sitio web. Filtra con type:card, is:favorite, has:otp, has:passkey, is:weak, folder:Work o vault:personal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาด้วยชื่อ ชื่อผู้ใช้ หรือเว็บไซต์ กรองด้วย type:card, is:favorite, has:otp, has:passkey, is:weak, folder:Work หรือ vault:personal."
          }
        }
      }
    },
    "Search everything, run any command. Over a browser or an app, its logins come first.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてを検索し、どのコマンドも実行できます。ブラウザやアプリの上では、そのログインが先頭に表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索所有项目、执行任何命令。在浏览器或 App 上调出时，会先列出相关的登录信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋所有項目、執行任何指令。在瀏覽器或 App 上叫出時，會先列出相關的登入資料。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋所有項目、執行任何指令。喺瀏覽器或者 App 上面叫出嚟時，會先列出相關嘅登入資料。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 것을 검색하고 어떤 명령이든 실행합니다. 브라우저나 앱 위에서는 해당 로그인이 먼저 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez tout, exécutez n'importe quelle commande. Au-dessus d'un navigateur ou d'une app, ses identifiants apparaissent en premier."
          }
        },
        "es": {
          "stringUnit": {
