    "Approve only if it matches the phrase on the other device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスのフレーズと一致する場合のみ承認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有与另一台设备上的短语相符时才批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在與另一台裝置上的短語相符時才核准。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "同另一部裝置上面嘅短語一致先批准。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기의 문구와 일치할 때만 승인하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’approuvez que si cela correspond à la phrase affichée sur l’autre appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba solo si coincide con la frase del otro dispositivo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุมัติเฉพาะเมื่อตรงกับวลีบนอุปกรณ์อีกเครื่อง"
          }
        }
      }
    },
    "Approve the sign-in on a device where you're signed in": {
      "localizations": {
