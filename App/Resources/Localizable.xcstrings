          }
        }
      }
    },
    "The link holds the key; the server never sees your content.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵はリンクの中にあり、サーバーは内容を見られません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥在链接中，服务器永远看不到内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰在連結中，伺服器永遠看不到內容。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "密鑰喺連結入面，伺服器永遠睇唔到內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크에 키가 들어 있으며, 서버는 내용을 볼 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien détient la clé ; le serveur ne voit jamais votre contenu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
