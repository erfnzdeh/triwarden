            "value": "Compartir por enlace"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ด้วยลิงก์"
          }
        }
      }
    },
    "Copy what you need now — this is the only time the passphrase can be shown.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy what you need now — this is the only time the passphrase can be shown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ必要なものをコピーしてください — パスフレーズを表示できるのはこの一度だけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在就把需要的复制好 —— 口令只有这一次能显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在就把需要的複製好 —— 口令只有這一次能顯示。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "而家就複製定要用嘅嘢 —— 個口令只有呢一次顯示得到。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 것을 지금 복사하세요 — 암호 문구는 이때만 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez ce dont vous avez besoin maintenant — c'est la seule fois où la phrase secrète peut s'afficher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia lo que necesites ahora: esta es la única vez que se puede mostrar la frase de contraseña."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกสิ่งที่ต้องใช้ตอนนี้ — วลีรหัสผ่านจะแสดงได้เพียงครั้งนี้เท่านั้น"
          }
        }
      }
    },
    "Create Send": {
      "localizations": {
