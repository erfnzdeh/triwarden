    "One leak exposes every site that shares a password. Give each its own.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 件の漏えいで同じパスワードのサイトすべてが危険になります。サイトごとに別のパスワードを。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次泄露就会波及所有共用密码的网站。请为每个网站设置不同密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次外洩就會波及所有共用密碼的網站。請為每個網站設定不同密碼。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "一次外洩就會波及所有共用密碼嘅網站。請為每個網站設定唔同密碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 유출로 같은 비밀번호를 쓰는 모든 사이트가 드러납니다. 사이트마다 다른 비밀번호를 쓰세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule fuite expose chaque site qui partage un mot de passe. Donnez-en un propre à chacun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola filtración expone todos los sitios que comparten una contraseña. Asigne una distinta a cada uno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรั่วไหลครั้งเดียวเปิดเผยทุกไซต์ที่ใช้รหัสผ่านเดียวกัน ให้แต่ละไซต์มีรหัสผ่านของตนเอง"
          }
        }
      }
    },
    "One touch opens every account that has it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 回のタッチで、有効にしたすべてのアカウントが開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻触一下即可打开所有已启用的账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕觸一下即可開啟所有已啟用的帳號。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "掂一下就可以開晒所有已啟用嘅帳戶。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 터치하면 이 기능을 켠 모든 계정이 열립니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une touche ouvre chaque compte où c’est activé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque abre cada cuenta que lo tiene activado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแตะครั้งเดียวจะเปิดทุกบัญชีที่เปิดใช้ไว้"
          }
        }
      }
    },
