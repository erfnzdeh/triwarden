    "Moving is one way: the shared vault owns the items afterwards.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動は一方向です。以後、項目は共有保管庫のものになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动是单向的：之后项目将归该共享保险库所有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移動是單向的：之後項目將屬於該共享保險庫。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "移動係單向嘅：之後項目會屬於個共享保險庫。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동은 한 방향입니다. 이후 항목은 공유 보관함 소유가 됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déplacement est à sens unique : le coffre partagé possède ensuite les éléments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El traslado es en un solo sentido: después, la caja fuerte compartida posee los elementos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การย้ายเป็นทางเดียว หลังจากนั้นห้องนิรภัยที่แชร์จะเป็นเจ้าของรายการ"
          }
        }
      }
    },
