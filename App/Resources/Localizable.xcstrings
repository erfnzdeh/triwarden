    "Add only the keys this tool needs. Each key must use a different environment variable.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このツールに必要なキーだけを追加してください。キーごとに別の環境変数を使う必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只加入这个工具需要的密钥。每个密钥必须使用不同的环境变量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只加入這個工具需要的金鑰。每把金鑰必須使用不同的環境變數。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
