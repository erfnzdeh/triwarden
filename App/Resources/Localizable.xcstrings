    "Provider error: check the key in your provider account. Never paste key values into a report.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダのエラー：プロバイダのアカウントでキーを確認してください。キーの値をレポートに貼り付けないでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供应商错误：请在你的供应商账户中检查密钥。切勿将密钥值粘贴到报告中。"
