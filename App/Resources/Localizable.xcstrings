    "%@ will ask again before its next SSH signature.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は次の SSH 署名の前に再度確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 下次进行 SSH 签名前会再次询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 下次進行 SSH 簽署前會再次詢問。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 下次做 SSH 簽署之前會再問你。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 다음 SSH 서명 전에 다시 묻습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demandera à nouveau avant sa prochaine signature SSH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ volverá a preguntar antes de su próxima firma SSH."
