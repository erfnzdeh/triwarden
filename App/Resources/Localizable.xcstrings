          }
        }
      }
    },
    "Encrypted with a password you choose. Recommended: Bitwarden and Triwarden can import it on any device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだパスワードで暗号化します。おすすめ：Bitwarden と Triwarden ならどのデバイスでも読み込めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你设定的密码加密。推荐：Bitwarden 和 Triwarden 在任何设备上都能导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以你設定的密碼加密。建議使用：Bitwarden 和 Triwarden 在任何裝置上都能匯入。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用你揀嘅密碼加密。建議使用：Bitwarden 同 Triwarden 喺任何裝置都匯入到。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 비밀번호로 암호화됩니다. 권장: Bitwarden과 Triwarden에서 모든 기기로 가져올 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffré avec un mot de passe de votre choix. Recommandé : Bitwarden et Triwarden peuvent l’importer sur n’importe quel appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrado con una contraseña que usted elija. Recomendado: Bitwarden y Triwarden pueden importarlo en cualquier dispositivo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้ารหัสด้วยรหัสผ่านที่คุณเลือก แนะนำ: Bitwarden และ Triwarden สามารถนำเข้าได้บนทุกอุปกรณ์"
          }
        }
