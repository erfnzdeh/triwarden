        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 会额外送出回车（提交表单）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 會額外送出回車（提交表單）"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 會同時撳 Return（提交表格）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift를 함께 누르면 Return도 눌러 양식을 제출합니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
