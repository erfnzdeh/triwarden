    "No events. The server keeps them only when its administrator turns event logging on (ORG_EVENTS_ENABLED).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントはありません。サーバー管理者がイベントログ（ORG_EVENTS_ENABLED）を有効にした場合のみ保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有事件。只有服务器管理员开启事件日志（ORG_EVENTS_ENABLED）时才会保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有事件。只有在伺服器管理員開啟事件記錄（ORG_EVENTS_ENABLED）時才會保存。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "冇事件。伺服器管理員開咗事件記錄（ORG_EVENTS_ENABLED）先會保存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트가 없습니다. 서버는 관리자가 이벤트 로깅(ORG_EVENTS_ENABLED)을 켠 경우에만 이벤트를 보관합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun événement. Le serveur ne les conserve que lorsque son administrateur active la journalisation des événements (ORG_EVENTS_ENABLED)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay eventos. El servidor solo los conserva cuando su administrador activa el registro de eventos (ORG_EVENTS_ENABLED)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีเหตุการณ์ เซิร์ฟเวอร์จะเก็บไว้เมื่อผู้ดูแลเปิดการบันทึกเหตุการณ์ (ORG_EVENTS_ENABLED) เท่านั้น"
          }
        }
      }
    },
