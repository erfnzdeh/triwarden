    },
    "This file is encrypted with another account's key. Import it into that account, or export it again as password-protected." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは別のアカウントの鍵で暗号化されています。そのアカウントに読み込むか、パスワード保護で書き出し直してください。"
