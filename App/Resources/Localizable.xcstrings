    "Logins and secure notes only, for spreadsheets and other password managers.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインとセキュアメモのみ。表計算や他のパスワードマネージャ向け。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅包含登录信息和安全备忘录，适用于电子表格和其他密码管理器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只包含登入資料與安全備忘錄，適用於試算表和其他密碼管理工具。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只包括登入資料同安全備忘錄，適合試算表同其他密碼管理工具。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인과 메모만 해당합니다. 스프레드시트와 다른 비밀번호 관리자용입니다."
          }
        },
        "fr": {
