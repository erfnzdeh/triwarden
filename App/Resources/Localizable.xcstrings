    "If this account has a hint, it's on its way to your inbox.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントにヒントがあれば、受信トレイに送信されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果此账户设有提示，已发送至你的收件箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果此帳號設有提示，已寄到你的收件匣。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如果呢個帳戶有設提示，已經寄咗去你嘅收件箱。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에 힌트가 있으면 받은 편지함으로 보내는 중입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ce compte a un indice, il est en route vers votre boîte de réception."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esta cuenta tiene una pista, va de camino a su bandeja de entrada."
