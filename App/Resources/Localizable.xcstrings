            "state": "translated",
            "value": "%@에서 로그아웃할까요?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déconnecter de %@ ?"
          }
        },
        "es": {
          "stringUnit": {
