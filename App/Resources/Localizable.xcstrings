        }
      }
    },
    "You can restore it from Trash for %lld days.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 日間はゴミ箱から戻せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天内可以从废纸篓恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天內可以從垃圾桶復原。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 日內可以喺垃圾桶攞返。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld일 동안 휴지통에서 복원할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez le restaurer depuis la corbeille pendant %lld jours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes restaurarlo desde la papelera durante %lld días."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณกู้คืนจากถังขยะได้ภายใน %lld วัน"
          }
        }
      }
    },
    "You can restore it from Trash later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとでゴミ箱から戻せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后可以从废纸篓恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後可以從垃圾桶復原。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "之後可以喺垃圾桶攞返。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 휴지통에서 복원할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez le restaurer depuis la corbeille plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes restaurarlo desde la papelera más tarde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณกู้คืนจากถังขยะได้ในภายหลัง"
          }
        }
      }
    },
    "You can restore them from Trash later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後でゴミ箱から復元できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后可以从废纸篓恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後可以從垃圾桶還原。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "之後可以喺垃圾桶攞返佢哋。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 휴지통에서 이들을 복원할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez les restaurer depuis la corbeille plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes restaurarlos desde la papelera más tarde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณกู้คืนรายการเหล่านี้จากถังขยะได้ในภายหลัง"
          }
        }
      }
    },
    "You're offline — changes need a connection to your server.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。変更にはサーバーへの接続が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前离线，更改需要连接到服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前離線，變更需要連線到伺服器。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你而家離線，改動要連線返你嘅伺服器。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인입니다 — 변경하려면 서버에 연결해야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne — les modifications nécessitent une connexion à votre serveur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión — los cambios necesitan una conexión con tu servidor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออฟไลน์อยู่ — การเปลี่ยนแปลงต้องเชื่อมต่อกับเซิร์ฟเวอร์ของคุณ"
          }
        }
      }
    },
    "Your account is signed in on each of these. Sign out everywhere if one isn't yours; this Mac signs straight back in.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは以下の各デバイスでサインインしています。心当たりのないものがあればすべてサインアウトしてください。この Mac はすぐにサインインし直します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户已在以下各设备登录。如有不是你的设备，请全部注销；这台 Mac 会立即重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帳號已在以下各裝置登入。若有不是你的裝置，請全部登出；這部 Mac 會立即重新登入。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你嘅帳戶喺以下每部裝置都登入咗。如果有唔係你嘅，就全部登出；呢部 Mac 會即刻重新登入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 다음 각 기기에서 로그인되어 있습니다. 본인 것이 아니면 모두 로그아웃하세요. 이 Mac은 바로 다시 로그인합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte est connecté sur chacun d’eux. Déconnectez-vous partout si l’un n’est pas à vous ; ce Mac se reconnecte aussitôt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta tiene la sesión iniciada en cada uno de estos. Cierra sesión en todos si alguno no es tuyo; este Mac vuelve a iniciar sesión de inmediato."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชีของคุณเข้าสู่ระบบอยู่ในแต่ละรายการนี้ หากมีรายการที่ไม่ใช่ของคุณ ให้ออกจากระบบทั้งหมด Mac เครื่องนี้จะเข้าสู่ระบบอีกครั้งทันที"
          }
        }
      }
    },
    "Your details, for filling in forms.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーム入力に使うあなたの情報。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的个人信息，用于填写表单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的個人資料，用於填寫表單。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你嘅個人資料，用嚟填表格。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양식을 채울 때 쓰는 내 정보입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos informations, pour remplir des formulaires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos, para rellenar formularios."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลของคุณ สำหรับกรอกแบบฟอร์ม"
          }
        }
      }
    },
    "Your master password can't be recovered — not even by the server. If you set a hint, we can email it to you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスターパスワードは復元できません（サーバーでも不可能です）。ヒントを設定していれば、メールで送信できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主密码无法恢复，连服务器也不行。如果你设置了提示，我们可以通过电子邮件发给你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主密碼無法復原，就連伺服器也不行。如果你有設定提示，我們可以用電子郵件寄給你。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "主密碼恢復唔到，連伺服器都一樣。如果你設定咗提示，我哋可以寄電郵畀你。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스터 비밀번호는 복구할 수 없습니다 — 서버도 마찬가지입니다. 힌트를 설정했다면 이메일로 보내 드릴 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mot de passe principal ne peut pas être récupéré — pas même par le serveur. Si vous avez défini un indice, nous pouvons vous l’envoyer par e-mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contraseña maestra no se puede recuperar — ni siquiera el servidor. Si definiste una pista, podemos enviártela por correo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านหลักกู้คืนไม่ได้ — แม้แต่เซิร์ฟเวอร์ก็ทำไม่ได้ หากคุณตั้งคำใบ้ไว้ เราสามารถส่งให้คุณทางอีเมลได้"
          }
        }
      }
    },
    "Your organization's SSO identifier. On Vaultwarden any value works.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組織の SSO 識別子。Vaultwarden では任意の値で構いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的组织 SSO 标识符。在 Vaultwarden 上任意值均可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的組織 SSO 識別碼。在 Vaultwarden 上任何值皆可。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你嘅機構 SSO 識別碼。喺 Vaultwarden 任何值都得。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조직의 SSO 식별자입니다. Vaultwarden에서는 아무 값이나 됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiant SSO de votre organisation. Sur Vaultwarden, n’importe quelle valeur convient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Identificador SSO de tu organización. En Vaultwarden cualquier valor sirve."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวระบุ SSO ขององค์กรคุณ บน Vaultwarden ใช้ค่าใดก็ได้"
          }
        }
      }
    },
    "Your other devices sign out; this Mac stays signed in.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のデバイスはサインアウトされます。この Mac はサインインしたままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的其他设备会登出；这台 Mac 会保持登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的其他裝置會登出；這台 Mac 會保持登入。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你嘅其他裝置會登出；呢部 Mac 會保持登入。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기는 로그아웃되고, 이 Mac은 로그인 상태를 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos autres appareils se déconnectent ; ce Mac reste connecté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus otros dispositivos cierran sesión; este Mac sigue con la sesión iniciada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์อื่นจะออกจากระบบ ส่วน Mac เครื่องนี้ยังเข้าสู่ระบบอยู่"
          }
        }
      }
    },
    "Your personal items and folders, in a file any Bitwarden app can import.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人の項目とフォルダを、どの Bitwarden アプリでも読み込めるファイルにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的个人项目和文件夹，存为任何 Bitwarden 应用都能导入的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的個人項目與資料夾，存成任何 Bitwarden App 都能匯入的檔案。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你嘅個人項目同資料夾，存成任何 Bitwarden App 都匯入到嘅檔案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 항목과 폴더를, 어떤 Bitwarden 앱에서도 가져올 수 있는 파일로 담습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos éléments et dossiers personnels, dans un fichier que toute app Bitwarden peut importer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus elementos y carpetas personales, en un archivo que cualquier app de Bitwarden puede importar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการและโฟลเดอร์ส่วนตัวของคุณ ในไฟล์ที่แอป Bitwarden ทุกแอปนำเข้าได้"
          }
        }
      }
    },
    "Your Sends appear here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Send はここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Send 会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Send 會顯示在這裡。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你嘅 Send 會喺呢度顯示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Send가 여기에 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos Send apparaissent ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus Send aparecen aquí."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Send ของคุณจะแสดงที่นี่"
          }
        }
      }
    },
    "Your vault is encrypted on this Mac until you unlock it.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを解除するまで、保管庫はこの Mac 上で暗号化されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你解锁之前，密码库都以加密形式存放在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你解鎖之前，密碼庫都以加密形式存放在這台 Mac 上。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺你解鎖之前，保險庫都係加密咗存喺呢部 Mac。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 해제할 때까지 보관함은 이 Mac에서 암호화되어 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre coffre est chiffré sur ce Mac jusqu’à ce que vous le déverrouilliez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu caja fuerte está cifrada en este Mac hasta que la desbloquees."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้องนิรภัยของคุณถูกเข้ารหัสบน Mac เครื่องนี้จนกว่าคุณจะปลดล็อก"
          }
        }
      }
    },
