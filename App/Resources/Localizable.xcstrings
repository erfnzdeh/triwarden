    "Account locked or sync failed: unlock or reconnect, then run it again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントがロック中か同期に失敗しました：ロックを解除するか再接続してから、もう一度実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户已锁定或同步失败：请解锁或重新连接，然后再运行一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號已鎖定或同步失敗：請解鎖或重新連線，然後再執行一次。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶鎖定咗或者同步失敗：請解鎖或者重新連線，然後再執行一次。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 잠겼거나 동기화에 실패했습니다: 잠금 해제하거나 다시 연결한 후 다시 실행하세요."
          }
        },
        "fr": {
