        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub に最新のリリース番号を問い合わせるだけで、自動でダウンロードやインストールはしません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会向 GitHub 查询最新版本号，不会自动下载或安装任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
