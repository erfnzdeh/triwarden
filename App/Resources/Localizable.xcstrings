    "Triwarden keeps working. You can register again with the same key at any time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden はそのまま使えます。同じキーでいつでも再登録できます。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden 照樣可以用。你隨時可以用同一個授權碼再註冊。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden 仍可继续使用。你随时可以用同一个密钥重新注册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden 仍可繼續使用。你隨時可以用同一組金鑰重新註冊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden은 계속 작동합니다. 같은 키로 언제든 다시 등록할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden continue de fonctionner. Vous pouvez l’enregistrer à nouveau avec la même clé à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden sigue funcionando. Puedes registrarla de nuevo con la misma clave en cualquier momento."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden ยังใช้งานได้ คุณสามารถลงทะเบียนอีกครั้งด้วยคีย์เดียวกันได้ทุกเมื่อ"
          }
        }
      }
    },
    "Enjoying Triwarden?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Triwarden を気に入っていただけましたか？"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "鍾唔鍾意 Triwarden？"
          }
        },
        "zh-Hans": {
