    "That doesn't look like a Chrome extension ID: 32 letters from a to p.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like a Chrome extension ID: 32 letters from a to p."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No parece un ID de extensión de Chrome: 32 letras de la a a la p."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas à un ID d’extension Chrome : 32 lettres de a à p."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome の拡張機能 ID ではないようです。a〜p の32文字です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome 확장 프로그램 ID가 아닌 것 같습니다. a부터 p까지의 32자입니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ใช่รหัสส่วนขยายของ Chrome: ตัวอักษร a ถึง p จำนวน 32 ตัว"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個唔似 Chrome 擴充功能 ID：要 32 個 a 至 p 嘅字母。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不像 Chrome 扩展 ID：应为 32 个 a 到 p 的字母。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不像 Chrome 擴充功能 ID：應為 32 個 a 到 p 的字母。"
          }
        }
      }
    },
