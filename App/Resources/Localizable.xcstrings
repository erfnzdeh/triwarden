    "Sync and inspect your vault before trying failed actions again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync and inspect your vault before trying failed actions again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試失敗的操作前，請先同步並檢查保管庫。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "重試失敗嘅操作之前，請先同步同檢查保險庫。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试失败的操作前，请先同步并检查密码库。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗した操作を再試行する前に同期して保管庫を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패한 작업을 다시 시도하기 전에 보관함을 동기화하고 확인하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez et examinez votre coffre avant de réessayer les actions échouées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza e inspecciona tu caja fuerte antes de volver a intentar las acciones que fallaron."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซิงค์และตรวจสอบห้องนิรภัยก่อนลองทำการทำงานที่ล้มเหลวอีกครั้ง"
          }
        }
      }
    },
