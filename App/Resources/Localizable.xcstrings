          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางคำสั่งนี้ในเทอร์มินัลเพื่อเริ่มเครื่องมือที่บันทึกไว้"
          }
        }
      }
    },
    "Paste with ⌘V and press Return": {
      "localizations": {
