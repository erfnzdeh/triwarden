          }
        }
      }
    },
    "Your .env file is only read. Triwarden never changes it or your shell settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".env ファイルは読み取るだけです。Triwarden がこのファイルやシェルの設定を変更することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 .env 文件只会被读取。Triwarden 绝不会更改它或你的 shell 设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 .env 檔案只會被讀取。Triwarden 絕不會更改它或你的 shell 設定。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你嘅 .env 檔案只會被讀取。Triwarden 永遠唔會改佢或者你嘅 shell 設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".env 파일은 읽기만 합니다. Triwarden은 이 파일이나 셸 설정을 절대 바꾸지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre fichier .env est seulement lu. Triwarden ne modifie jamais ce fichier ni les réglages de votre shell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu archivo .env solo se lee. Triwarden nunca lo modifica ni cambia los ajustes de tu shell."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ .env ของคุณจะถูกอ่านเท่านั้น Triwarden ไม่เปลี่ยนไฟล์นี้หรือการตั้งค่าเชลล์ของคุณ"
          }
        }
      }
    },
    "Your API key stays in your vault. You choose which tool receives it, and you approve each launch.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーは保管庫に残ります。どのツールに渡すかを選び、起動のたびに承認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 API 密钥会留在保险库中。由你选择哪个工具接收，并批准每次启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 API 金鑰會留在保險庫中。由你選擇哪個工具接收，並核准每次啟動。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你嘅 API 密鑰會留喺保險庫。由你揀邊個工具收佢，每次啟動都由你批准。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키는 보관함에 남습니다. 키를 받을 도구를 직접 선택하고 실행할 때마다 승인합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé d'API reste dans votre coffre. Vous choisissez quel outil la reçoit, et vous autorisez chaque lancement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave de API permanece en tu caja fuerte. Tú eliges qué herramienta la recibe y apruebas cada inicio."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ API ของคุณยังอยู่ในห้องนิรภัย คุณเลือกได้ว่าเครื่องมือใดจะได้รับ และอนุมัติการเรียกใช้แต่ละครั้ง"
          }
        }
