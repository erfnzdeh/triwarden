          }
        }
      }
    },
    "With the window closed, Triwarden leaves the Dock and waits in the menu bar. Shortcuts, AutoFill and the command palette keep working.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを閉じると、Triwarden は Dock から消えてメニューバーで待機します。ショートカット、自動入力、コマンドパレットは引き続き使えます。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉視窗之後，Triwarden 會離開 Dock，喺選單列度待命。快捷鍵、自動填寫同指令面板照用得。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭窗口后，Triwarden 会离开程序坞并在菜单栏中待命。快捷键、自动填充和命令面板仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉視窗後，Triwarden 會離開 Dock 並在選單列中待命。快速鍵、自動填寫和指令面板仍可使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 닫으면 Triwarden은 Dock에서 사라지고 메뉴 막대에서 대기합니다. 단축키, 자동 완성, 명령 팔레트는 계속 작동합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenêtre fermée, Triwarden quitte le Dock et attend dans la barre des menus. Les raccourcis, le remplissage automatique et la palette de commandes continuent de fonctionner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la ventana cerrada, Triwarden sale del Dock y espera en la barra de menús. Los atajos, el autorrelleno y la paleta de comandos siguen funcionando."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิดหน้าต่าง Triwarden จะออกจาก Dock และรออยู่ในแถบเมนู ทางลัด การป้อนอัตโนมัติ และพาเล็ตคำสั่งยังใช้ได้"
          }
        }
      }
    },
    "With your generator settings, straight to the clipboard.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジェネレータの設定で作り、そのままクリップボードへ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按照你的生成器设置，直接拷贝到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照你的產生器設定，直接拷貝到剪貼簿。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "跟你嘅產生器設定，直接複製到剪貼簿。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성기 설정 그대로, 바로 클립보드로."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec les réglages du générateur, directement dans le presse-papiers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con los ajustes del generador, directo al portapapeles."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตามการตั้งค่าตัวสร้างรหัสผ่าน ส่งตรงไปยังคลิปบอร์ด"
          }
        }
      }
    },
    "Without the menu bar icon, open Triwarden from the Dock, Spotlight or its shortcuts.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのアイコンがない場合は、Dock、Spotlight、またはショートカットから Triwarden を開いてください。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "冇選單列圖示嘅時候，可以由 Dock、Spotlight 或者快捷鍵打開 Triwarden。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有菜单栏图标时，请从程序坞、聚焦搜索或快捷键打开 Triwarden。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有選單列圖像時，請從 Dock、Spotlight 或快速鍵打開 Triwarden。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 아이콘이 없으면 Dock, Spotlight 또는 단축키에서 Triwarden을 여세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans l’icône de la barre des menus, ouvrez Triwarden depuis le Dock, Spotlight ou ses raccourcis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin el icono de la barra de menús, abre Triwarden desde el Dock, Spotlight o sus atajos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีไอคอนแถบเมนู ให้เปิด Triwarden จาก Dock, Spotlight หรือทางลัด"
          }
        }
      }
    },
    "Word separator": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語の区切り"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分隔符"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分隔符號"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "分隔符號"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어 구분 문자"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séparateur de mots"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separador de palabras"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวคั่นคำ"
          }
        }
      }
    },
    "Works in every app. Called over a browser or an app, the palette puts its logins first, and ↵ types the username and password in (⌃↵ username, ⌥↵ password, ⇧ & submit). Typing needs Accessibility for “Triwarden Auto-Type”, a small helper inside the app, so Triwarden itself stays sandboxed. The palette's shortcut works inside the vault window too.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリでも使えます。ブラウザやアプリの上で呼び出すと、そのログインが先頭に表示され、↵ でユーザ名とパスワードを入力します（⌃↵ はユーザ名のみ、⌥↵ はパスワードのみ、⇧ & 送信）。入力にはアプリ内のヘルパー「Triwarden Auto-Type」へのアクセシビリティ許可が必要で、Triwarden 本体はサンドボックスのままです。このショートカットは保管庫ウインドウ内でも使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何 App 中都能使用。在浏览器或其他 App 上调出时，命令面板会先列出相关的登录信息，按 ↵ 会输入用户名和密码（⌃↵ 只输入用户名，⌥↵ 只输入密码，⇧ & 提交）。输入功能需要为 App 内的小助手“Triwarden Auto-Type”开启“辅助功能”权限，Triwarden 本身仍保持沙盒保护。在密码库窗口内也能用这个快捷键打开命令面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何 App 中都能使用。在瀏覽器或其他 App 上叫出時，命令面板會先列出相關的登入資料，按 ↵ 會輸入使用者名稱和密碼（⌃↵ 只輸入使用者名稱，⌥↵ 只輸入密碼，⇧ & 送出）。輸入功能需要為 App 內的小幫手「Triwarden Auto-Type」開啟「輔助使用」權限，Triwarden 本身仍維持沙盒保護。在保險庫視窗內也能用這個快速鍵開啟命令面板。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺任何 App 都用得。喺瀏覽器或者其他 App 叫出嚟時，指令面板會先列出相關嘅登入資料，撳 ↵ 會輸入用戶名同密碼（⌃↵ 淨係輸入用戶名，⌥↵ 淨係輸入密碼，⇧ & 提交）。輸入功能要幫 App 入面嘅小幫手「Triwarden Auto-Type」開啟「輔助使用」權限，Triwarden 本身依然受沙盒保護。喺保險庫視窗入面都可以用呢個快捷鍵開指令面板。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 앱에서 작동합니다. 브라우저나 앱 위에서 호출하면 팔레트가 해당 로그인을 맨 앞에 두고, ↵가 사용자 이름과 비밀번호를 입력합니다(⌃↵ 사용자 이름, ⌥↵ 비밀번호, ⇧ & 제출). 입력하려면 앱 안의 작은 도우미 “Triwarden Auto-Type”에 대한 손쉬운 사용 권한이 필요하며, Triwarden 본체는 샌드박스를 유지합니다. 팔레트의 단축키는 보관함 윈도우 안에서도 작동합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne dans toutes les apps. Invoquée au-dessus d’un navigateur ou d’une app, la palette place ses identifiants en premier, et ↵ saisit le nom d’utilisateur et le mot de passe (⌃↵ nom d’utilisateur, ⌥↵ mot de passe, ⇧ & envoi). La saisie exige l’accessibilité pour « Triwarden Auto-Type », un petit assistant dans l’app, afin que Triwarden lui-même reste dans le bac à sable. Le raccourci de la palette fonctionne aussi dans la fenêtre du coffre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona en todas las apps. Al invocarla sobre un navegador o una app, la paleta pone primero sus inicios de sesión, y ↵ escribe el nombre de usuario y la contraseña (⌃↵ nombre de usuario, ⌥↵ contraseña, ⇧ & enviar). Escribir requiere Accesibilidad para «Triwarden Auto-Type», un pequeño asistente dentro de la app, para que el propio Triwarden permanezca en el sandbox. El atajo de la paleta también funciona dentro de la ventana de la caja fuerte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ได้ในทุกแอป เมื่อเรียกเหนือเบราว์เซอร์หรือแอป พาเล็ตจะนำข้อมูลเข้าสู่ระบบของแอปนั้นไว้ก่อน และ ↵ จะพิมพ์ชื่อผู้ใช้กับรหัสผ่าน (⌃↵ ชื่อผู้ใช้, ⌥↵ รหัสผ่าน, ⇧ & ส่ง) การพิมพ์ต้องได้รับสิทธิ์การช่วยการเข้าถึงสำหรับ “Triwarden Auto-Type” ตัวช่วยขนาดเล็กในแอป เพื่อให้ตัว Triwarden ยังอยู่ในแซนด์บ็อกซ์ ทางลัดของพาเล็ตใช้ได้ในหน้าต่างห้องนิรภัยด้วย"
          }
        }
      }
    },
    "Write it down and keep it somewhere safe, away from this Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き留めて、この Mac 以外の安全な場所に保管してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把它写下来，保存在 Mac 以外的安全地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把它寫下來，存放在 Mac 以外的安全地方。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫低佢，放喺 Mac 以外嘅安全地方。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적어서 이 Mac과 떨어진 안전한 곳에 보관하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez-le et conservez-le en lieu sûr, à l’écart de ce Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anótalo y guárdalo en un lugar seguro, lejos de este Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จดไว้แล้วเก็บในที่ปลอดภัย ให้ห่างจาก Mac เครื่องนี้"
          }
        }
      }
    },
    "Wrong email or master password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスまたはマスターパスワードが正しくありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电子邮件或主密码错误。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電子郵件或主密碼錯誤。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
