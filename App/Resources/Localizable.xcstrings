    "Show just one vault while this Focus is on, like your team's shared vault.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この集中モードの間は、チームの共有保管庫など1つの保管庫だけを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此专注模式开启时只显示一个保险库，例如团队的共享保险库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
