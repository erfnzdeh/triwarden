---
import Shot from "./Shot.astro";
import { m } from "../paraglide/messages.js";
---
<section id="features" class="mx-auto grid max-w-(--max) items-center gap-[5vw] px-(--gutter) py-[clamp(64px,8vw,112px)] lg:grid-cols-[minmax(0,.8fr)_minmax(0,1.2fr)]">
  <div data-reveal-group class="[&>p:not(.kicker)]:mt-[26px] [&>p:not(.kicker)]:max-w-[440px] [&>p:not(.kicker)]:text-lg [&>p:not(.kicker)]:text-ink-2">
    <p class="kicker">{m.palette_kicker()}</p>
    <h2>{m.palette_title_1()}<br /><em>{m.palette_title_2()}</em></h2>
    <p set:html={m.palette_p1({ shortcut: "<kbd>⇧⌘Space</kbd>" })} />
    <p set:html={m.palette_p2({ shortcut: "<kbd>⇧⌘Space</kbd>" })} />
  </div>
  <div data-rise style="--zoom-origin: 50% 7%; --zoom: 1.4" class="shot-zoom"><Shot name="palette-focus" alt={m.alt_palette()} /></div>
</section>
