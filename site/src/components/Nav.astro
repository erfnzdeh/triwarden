---
import { versioned } from "../versioned";
import { SITE } from "../config";
import { m } from "../paraglide/messages.js";
import { latestRelease, formatSize } from "../release";
import LangSwitch from "./LangSwitch.astro";
import { currentLocale, localeHref } from "../i18n";

interface Props { page?: string }
const { page = "" } = Astro.props;
const locale = currentLocale();
const home = page ? localeHref(locale) : "";

const rel = await latestRelease();
const dmg = rel?.dmg ?? SITE.download;
// In page order. Pricing is its own page (shareable for Buy / Lemon redirects); the rest stay on the home anchors.
const links = [
  [`${home}#screens`, m.nav_screens()],
  [`${home}#features`, m.nav_features()],
  [`${home}#security`, m.nav_security()],
  [localeHref(locale, "pricing/"), m.nav_pricing()],
  [`${home}#faq`, m.nav_faq()],
];

let stars: number | null = null;
try {
  const response = await fetch(SITE.api, { headers: { Accept: "application/vnd.github+json" } });
  if (response.ok) {
    const data = await response.json();
    if (typeof data.stargazers_count === "number") stars = data.stargazers_count;
  }
} catch {}
const githubIcon = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 .8a11.2 11.2 0 0 0-3.5 21.8c.6.1.8-.2.8-.5v-2.1c-3.4.7-4.1-1.4-4.1-1.4-.6-1.3-1.4-1.7-1.4-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.6-1.4-5.6-6.2 0-1.4.5-2.5 1.3-3.4-.1-.3-.6-1.6.1-3.3 0 0 1.1-.3 3.5 1.3a12 12 0 0 1 6.4 0c2.4-1.6 3.5-1.3 3.5-1.3.7 1.7.2 3 .1 3.3.8.9 1.3 2 1.3 3.4 0 4.8-2.9 5.9-5.6 6.2.4.4.8 1.1.8 2.2v3.1c0 .3.2.6.8.5A11.2 11.2 0 0 0 12 .8Z"/></svg>';
const starLabel = stars === null ? m.nav_star_label() : m.nav_star_label_count({ count: String(stars) });
const downloadIcon = '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 2.5v7.5M4.8 7l3.2 3.2L11.2 7M3 13.2h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<header data-nav class="topbar">
  <div class="topbar__inner">
    <a class="topbar__brand" href={page ? home : "#top"} aria-label="Triwarden">
      <img src={versioned("assets/icon.svg")} alt="" width="30" height="30" />
      <span class="topbar__name">Triwarden</span>
    </a>

    <nav class="topbar__links" aria-label={m.nav_features()} data-nav-links>
      <span class="topbar__indicator" aria-hidden="true" data-nav-indicator></span>
      {links.map(([href, label]) => <a href={href} data-nav-link aria-current={href === localeHref(locale, page) ? "page" : undefined}>{label}</a>)}
    </nav>

    <div class="topbar__end">
      <div class="topbar__group">
        <LangSwitch page={page} />
        <span class="topbar__divider" aria-hidden="true"></span>
        <button data-theme-toggle data-to-dark={m.nav_to_dark()} data-to-light={m.nav_to_light()} type="button" class="topbar__icon" aria-label={m.nav_to_dark()}>
          <span class="theme-swap" aria-hidden="true">
            <svg class="theme-swap__moon" viewBox="0 0 20 20" width="16" height="16"><path d="M16.5 12.2A6.8 6.8 0 0 1 7.8 3.5a6.8 6.8 0 1 0 8.7 8.7Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
            <svg class="theme-swap__sun" viewBox="0 0 20 20" width="16" height="16"><circle cx="10" cy="10" r="3.4" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </span>
        </button>
      </div>

      <a class="topbar__star topbar__desktop-star" href={SITE.repo} data-star-link data-star-label={m.nav_star_label_count({ count: "{count}" })} aria-label={starLabel}>
        <Fragment set:html={githubIcon} /><span aria-hidden="true">☆</span><span data-stars>{stars ?? "–"}</span>
      </a>

      <a class="btn btn--fill btn--sm topbar__download" href={dmg} data-dmg="">
        <Fragment set:html={downloadIcon} />{m.nav_download()}
      </a>

      <button type="button" class="topbar__menu" data-nav-menu aria-expanded="false" aria-controls="nav-sheet" data-open-label={m.nav_menu()} data-close-label={m.nav_close()} aria-label={m.nav_menu()}>
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="nav-sheet" class="topbar__sheet" data-nav-sheet hidden>
    <nav aria-label={m.nav_features()}>
      {links.map(([href, label]) => <a href={href} data-sheet-link>{label}</a>)}
    </nav>
    <a class="topbar__source" href={SITE.repo} data-star-link data-star-label={m.nav_star_label_count({ count: "{count}" })} aria-label={starLabel}><span class="inline-flex items-center gap-2"><Fragment set:html={githubIcon} />GitHub</span><span class="inline-flex items-center gap-2"><span aria-hidden="true">☆</span><span data-stars>{stars ?? "–"}</span><span aria-hidden="true">↗</span></span></a>
    <a class="btn btn--fill topbar__sheet-download" href={dmg} data-dmg=""><Fragment set:html={downloadIcon} />{m.hero_download()}{rel && <span class="font-normal opacity-70">· <span data-dmg-size>{formatSize(rel.size)}</span></span>}</a>
  </div>
</header>

<script>import "../scripts/nav";</script>
