---
import { SITE } from "../config";
import { m } from "../paraglide/messages.js";
import { latestRelease } from "../release";
import DownloadMeta from "./DownloadMeta.astro";
import { currentLocale, localeHref } from "../i18n";
const rel = await latestRelease();
const dmg = rel?.dmg ?? SITE.download;
const pricing = localeHref(currentLocale(), "pricing/");
const specs = [
  [m.spec_works_with(), m.spec_works_with_value()],
  [m.spec_unlock(), m.spec_unlock_value()],
  [m.spec_price(), m.spec_price_value({ price: SITE.price })],
];
---
<section id="top" class="hero relative isolate mx-auto grid min-h-svh max-w-[1560px] items-center gap-[2vw] px-(--gutter) pt-[120px] pb-20 *:min-w-0 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] max-lg:pt-[110px]">
  <div data-shader="hero" class="hero-backdrop" aria-hidden="true"></div>
  <div data-hero-copy>
    <h1 class="m-0 font-serif text-[clamp(64px,10.4vw,168px)] leading-[.86] font-normal tracking-[-.035em]">
      <span class="hero-line block overflow-hidden pb-[.26em] -mb-[.2em]"><span class="inline-block">{m.hero_title_1()}</span></span>
      <span class="hero-line block overflow-hidden pb-[.26em] -mb-[.2em]"><em class="inline-block text-ink">{m.hero_title_2()}</em></span>
    </h1>
    <p data-reveal class="my-[34px] max-w-[490px] text-[clamp(17px,1.4vw,19.5px)] text-ink-2">
      {m.hero_lede()}
    </p>
    <div data-reveal class="flex flex-wrap gap-3">
      <a class="btn btn--fill" href={dmg} data-dmg="">
        <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="M13.6 10.6c0-1.9 1.6-2.8 1.6-2.9-.9-1.3-2.3-1.5-2.8-1.5-1.2-.1-2.3.7-2.9.7-.6 0-1.5-.7-2.5-.7-1.3 0-2.5.8-3.2 1.9-1.4 2.4-.4 5.9 1 7.8.6.9 1.4 2 2.4 1.9 1-.1 1.3-.6 2.5-.6s1.5.6 2.5.6 1.7-1 2.3-1.9c.7-1 1-2 1-2.1 0 0-2-.8-1.9-3.2ZM11.7 4.9c.5-.7.9-1.6.8-2.5-.8 0-1.7.5-2.3 1.2-.5.6-.9 1.5-.8 2.4.9.1 1.8-.4 2.3-1.1Z"/></svg>
        {m.hero_download()}
      </a>
      <a class="btn btn--ghost" href={pricing}>{m.buy_once({ price: SITE.price })}</a>
    </div>
    <p data-reveal class="mt-4 mb-0 max-w-[490px] text-[13px] leading-relaxed text-ink-2">{m.hero_purchase_note({ price: SITE.price })}</p>
    <div data-reveal><DownloadMeta class="mt-3" /></div>
    <button data-reveal data-copy-text={SITE.brew} class="group mt-4 inline-flex max-w-full flex-wrap items-center gap-x-2.5 gap-y-1 rounded-[10px] border-0 bg-transparent p-0 text-left font-mono text-[13px] text-ink-3 transition-colors hover:text-ink" aria-label={m.copy_brew()} data-copy-done={m.copied()} data-copy-fail={m.copy_failed()}>
      <span class="min-w-0 max-w-full whitespace-normal [overflow-wrap:anywhere]"><span class="text-ink-3/70">$</span> {SITE.brew}</span>
      <span data-copy-label class="shrink-0 rounded-md px-1.5 py-0.5 text-[11.5px] tracking-wide uppercase shadow-[inset_0_0_0_1px_var(--color-line-2)] group-hover:text-ink">{m.copy()}</span>
    </button>
    <dl data-reveal class="mt-12 flex max-w-[600px] flex-wrap gap-x-10 gap-y-3.5 border-t border-line pt-6">
      {specs.map(([dt, dd]) => (
        <div>
          <dt class="mb-2 font-mono text-[11.5px] leading-none tracking-[.12em] text-ink-3 uppercase">{dt}</dt>
          <dd class="m-0 text-[14.5px] font-medium">{dd}</dd>
        </div>
      ))}
    </dl>
  </div>
  <div data-dial="hero" aria-hidden="true" class="relative aspect-square w-[min(64vw,900px)] justify-self-center -mr-[6vw] max-lg:order-first max-lg:mx-auto max-lg:-mb-2.5 max-lg:w-[min(92vw,560px)]"></div>
  <div aria-hidden="true" class="absolute right-(--gutter) bottom-[34px] hidden gap-7 font-mono text-[11.5px] leading-none tracking-[.1em] text-ink-3 tabular-nums lg:flex">
    <span data-readout>ROTOR 135.0° · −75.0° · 30.0°</span>
    <span>KEYWAY 6:00</span>
  </div>
</section>

<script>import "../scripts/hero"; import "../scripts/shader";</script>
